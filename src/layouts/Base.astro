---
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Nav from '../components/Nav.astro';
import fotoPorDefecto from '../assets/home/hero-sumac.jpg';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  theme?: 'wayra' | 'mayu';
  /** foto de la vista previa al compartir el link (WhatsApp, Instagram); por defecto, la fachada de Sumac */
  imagen?: { src: ImageMetadata; alt: string };
  /** páginas que no van a Google (por ejemplo, la futura "Tu llegada") */
  noindex?: boolean;
  /** datos estructurados (schema.org) de la página */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  theme,
  imagen = { src: fotoPorDefecto, alt: 'Fachada de Sumac Mayu, casa de adobe con cúpula y ventanal en arco' },
  noindex = false,
  jsonLd,
} = Astro.props;

const canonica = new URL(Astro.url.pathname, Astro.site);

// La vista previa al compartir: 1200 × 630 recortada, en JPG (WhatsApp no muestra AVIF)
const og = await getImage({ src: imagen.src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Solo la recta: la itálica se descarga cuando una página la usa -->
    <Font cssVariable="--font-fraunces" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-figtree" preload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Vista previa al compartir el link -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Misky Wayra" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagen.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify({ image: ogUrl.href, ...jsonLd })} />}
    <!-- Al pasar el mouse por un link a una cabaña, Chrome la prepara de antemano:
         la foto ya está cargada cuando arranca la transición. Otros navegadores lo ignoran. -->
    <script type="speculationrules" is:inline>
      { "prerender": [{ "where": { "href_matches": "/cabanas/*" }, "eagerness": "moderate" }] }
    </script>
  </head>
  <body data-theme={theme}>
    <Nav />

    <main>
      <slot />
    </main>

    <footer>
      <p>Misky Wayra, Capilla del Monte, Córdoba</p>
    </footer>
  </body>
</html>
