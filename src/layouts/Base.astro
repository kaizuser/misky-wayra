---
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  theme?: 'wayra' | 'mayu';
}

const { title, description, theme } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Solo la recta: la itálica se descarga cuando una página la usa -->
    <Font cssVariable="--font-fraunces" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-figtree" preload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Al pasar el mouse por un link a una cabaña, Chrome la prepara de antemano:
         la foto ya está cargada cuando arranca la transición. Otros navegadores lo ignoran. -->
    <script type="speculationrules" is:inline>
      { "prerender": [{ "where": { "href_matches": "/cabanas/*" }, "eagerness": "moderate" }] }
    </script>
  </head>
  <body data-theme={theme}>
    <Nav />

    <main>
      <slot />
    </main>

    <footer>
      <p>Misky Wayra, Capilla del Monte, Córdoba</p>
    </footer>
  </body>
</html>
