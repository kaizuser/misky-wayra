---
/**
 * Galería de fotos: lo que comparten las dos casas (el parque, la pileta, el fogón y las
 * pérgolas). Lo de adentro de cada casa está en su página.
 *
 * Editorial, como los ambientes de las cabañas: cada grupo tiene su cabeza (número, nombre
 * grande, una línea) sobre una regla fina, y debajo sus fotos verticales en tres columnas
 * escalonadas (la del medio más baja, la de la derecha a mitad de camino), sin carrusel:
 * acá se viene a mirar todo. En el celular, una foto por fila con ritmo (ancha, angosta a la
 * derecha, angosta a la izquierda), para que cada una se aprecie sola. Tocar una foto la abre
 * en grande y se recorre el grupo con las flechas.
 * Abre con una foto grande y vertical al lado del título (todas las fotos son verticales).
 */
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Franja from '../components/Franja.astro';
import Ampliable from '../components/Ampliable.astro';
import { ruta } from '../lib/rutas';

const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/galeria/*.jpg', { eager: true });
const foto = (nombre: string, alt: string) => ({ src: archivos[`../assets/galeria/${nombre}.jpg`].default, alt });

/** La foto que abre la página: la más linda del parque */
const portada = foto('jardin_03', 'Rosas rojas en primer plano y Sumac Mayu desenfocada al fondo, junto a la pileta');

const grupos = [
  {
    titulo: 'El parque',
    texto: 'Tres mil metros de parque, con árboles frutales y nativos, flores y senderos entre las dos casas.',
    fotos: [
      foto('jardin_12', 'Sendero de piedras entre el pasto y los canteros con flores, a la sombra de los árboles del parque'),
      foto('jardin_09', 'Sumac Mayu entre los árboles del parque, con flores lilas en primer plano'),
      foto('jardin_04', 'Flores lilas en primer plano y la cúpula de Sumac Mayu desenfocada detrás de los árboles'),
      foto('jardin_05', 'Flores rojas y el tronco de un árbol en primer plano, con la pileta al fondo'),
      foto('jardin_14', 'Cantero con un agave, flores y piedras, con el tanque de agua detrás'),
      foto('jardin_15', 'Agaves y flores bajo los árboles, junto a un portón de madera'),
    ],
  },
  {
    titulo: 'La pileta',
    texto: 'La pileta de temporada, con su muro de piedra, los decks y el Uritorco de fondo.',
    fotos: [
      foto('jardin_11', 'El Cerro Uritorco detrás de la pileta y su muro de piedra'),
      foto('pileta_02', 'La pileta con Sumac Mayu detrás'),
      foto('pileta_01', 'La pileta y el deck de madera con sillones, bajo una pérgola'),
      foto('jardin_06', 'Flores lilas frente a la pileta, con las sierras al fondo'),
      foto('pileta_03', 'Un sillón de madera en el deck junto a la pileta, con Sumac Mayu de fondo'),
      foto('deck_01', 'Reposeras sobre el deck, bajo una pérgola, junto a la pileta'),
    ],
  },
  {
    titulo: 'El fogón y las pérgolas',
    texto: 'El fogón con sus bancos, la parrilla y las pérgolas, para estar afuera a la sombra.',
    fotos: [
      foto('fogon_02', 'El fogón con bancos de madera y hierro sobre el ripio, con la pileta al fondo'),
      foto('jardin_08', 'Pérgola de hierro en arco sobre el pasto, con Sumac Mayu al fondo'),
      foto('fogon_01', 'El fogón rodeado de piedras, bajo un árbol grande'),
      foto('jardin_10', 'Sillones bajo una pérgola cubierta de plantas'),
      foto('jardin_02', 'La parrilla y un brasero bajo los árboles, junto a una glorieta de hierro'),
      foto('jardin_13', 'Sillones a la sombra de una glorieta de hierro con plantas'),
    ],
  },
];
---

<Base
  title="Galería de fotos: Misky Wayra, Capilla del Monte"
  description="Fotos del parque, la pileta, el fogón y las pérgolas que comparten las cabañas Misky Wayra, frente al Uritorco en Capilla del Monte, Córdoba."
>
  <Franja />

  <section class="encabezado">
    <div class="titulo">
      <p class="antetitulo" data-revelar>Lo que comparten las dos casas</p>
      <h1 data-revelar style="--retraso: 0.08s">Galería</h1>
      <p class="intro" data-revelar style="--retraso: 0.16s">
        El parque, la pileta, el fogón y las pérgolas. Las casas por dentro están en la página de cada una.
      </p>
    </div>
    <div class="portada" data-galeria data-revelar="foto">
      <Ampliable foto={portada} widths={[500, 800, 1080]} sizes="(min-width: 48rem) 38vw, 100vw" prioridad />
    </div>
  </section>

  {
    grupos.map((grupo, i) => (
      <section class="grupo" aria-labelledby={`grupo-${i}`}>
        <header class="cabeza" data-revelar>
          <p class="numero">{String(i + 1).padStart(2, '0')}</p>
          <h2 id={`grupo-${i}`}>{grupo.titulo}</h2>
          <p class="texto">{grupo.texto}</p>
        </header>

        <ul class="fotos" data-galeria>
          {grupo.fotos.map((f, j) => (
            <li class="foto" data-revelar="foto" style={`--retraso: ${(j % 3) * 0.1}s`}>
              <Ampliable foto={f} widths={[400, 700, 1000]} sizes="(min-width: 48rem) 30vw, 100vw" />
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="casas">
    <p data-revelar>
      Por dentro:
      <a href={ruta('/cabanas/sumac-mayu/')} data-theme="mayu">Sumac Mayu</a>
      y
      <a href={ruta('/cabanas/misky-wayra/')} data-theme="wayra">Misky Wayra</a>.
    </p>
  </section>
</Base>

<script>
  import '../scripts/revelar';
  import '../scripts/lightbox';
</script>

<style>
  section {
    --margen: max(var(--gutter), (100vw - var(--axis-width)) / 2);

    padding-inline: var(--margen);
    text-align: start;
  }

  section :global(p) {
    margin-inline: 0;
  }

  /* ---------- El encabezado: el título contra la izquierda y la portada a la derecha ---------- */
  .encabezado {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }

  .portada {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }

  .portada :global(picture),
  .portada :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Desktop: dos columnas, el título abajo a la izquierda, la foto alta a la derecha */
  @media (width >= 48rem) {
    .encabezado {
      grid-template-columns: 1fr minmax(0, 38vw);
      align-items: end;
      gap: var(--space-2xl);
      padding-block: var(--space-2xl) var(--space-3xl);
    }

    .portada {
      max-height: calc(100svh - 8rem);
      aspect-ratio: auto;
      height: min(57vw, calc(100svh - 8rem)); /* 2:3 del ancho, sin pasarse de la pantalla */
    }
  }

  .antetitulo {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  h1 {
    margin-block-start: var(--space-xs);
    font-size: clamp(4rem, 2rem + 9vw, 10rem);
    line-height: 0.9;
    color: var(--color-text);
  }

  .intro {
    margin-block-start: var(--space-l);
    max-width: 34rem;
  }

  /* ---------- Cada grupo: la cabeza, como en los ambientes ---------- */
  .grupo {
    padding-block: var(--space-2xl);
  }

  .cabeza {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: var(--space-2xs) var(--space-m);
    padding-block-end: var(--space-m);
    border-block-end: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
  }

  .numero {
    padding-block-end: 0.5rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--color-primary);
  }

  h2 {
    font-size: clamp(2.4rem, 1.2rem + 3.6vw, 4.5rem);
    line-height: 1;
    color: var(--color-text);
  }

  .texto {
    grid-column: 1 / -1;
    max-width: 30rem;
  }

  @media (width >= 64rem) {
    .cabeza {
      grid-template-columns: auto 1fr minmax(0, 24rem);
    }

    .texto {
      grid-column: auto;
      padding-block-end: 0.4rem;
    }
  }

  /* ---------- Las fotos ----------
     Celular: una por fila, con ritmo: ancha, angosta a la derecha, angosta a la izquierda.
     Cada foto ocupa su pantalla y se aprecia sola. */
  .fotos {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .foto {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }

  .foto:nth-child(3n + 2) {
    width: 72%;
    justify-self: end;
  }

  .foto:nth-child(3n) {
    width: 72%;
    justify-self: start;
  }

  /* Desktop: tres columnas escalonadas, alineadas arriba (sin hueco bajo la regla).
     La primera foto del medio es más alta (2:3.6) y la de la derecha un poco (2:3.3); el sobrante
     no empuja la fila (margen negativo, en % del ancho), y las fotos siguientes de esas columnas
     bajan lo mismo. Así el escalón queda solo abajo, donde se pierde en el espacio del grupo. */
  @media (width >= 48rem) {
    .fotos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-2xl) clamp(1rem, 2.2vw, 2rem);
      padding-block-end: 10%; /* % del ancho de la grilla: lo que baja la columna del medio (~30% de una foto) */
    }

    .foto:nth-child(n) {
      width: auto;
      justify-self: stretch;
    }

    .foto:nth-child(2) {
      aspect-ratio: 2 / 3.6;
      margin-block-end: -30%;
    }

    .foto:nth-child(3) {
      aspect-ratio: 2 / 3.3;
      margin-block-end: -15%;
    }

    /* 20% y 10% de su propia altura (1.5 × ancho) = 30% y 15% del ancho */
    .foto:nth-child(3n + 2):not(:nth-child(2)) {
      transform: translateY(20%);
    }

    .foto:nth-child(3n):not(:nth-child(3)) {
      transform: translateY(10%);
    }
  }

  .foto :global(picture),
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Al pasar el mouse, la foto se acerca despacio */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .foto :global(img) {
      transition: scale 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .foto:hover :global(img) {
      scale: 1.04;
    }
  }

  /* ---------- Al final: las casas por dentro ---------- */
  .casas {
    padding-block: var(--space-2xl) var(--space-3xl);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 3rem);
    line-height: 1.15;
  }

  .casas a {
    color: var(--color-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
</style>
