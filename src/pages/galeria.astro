---
/**
 * Galería de fotos: el parque, la pileta, el fogón y las pérgolas. Lo de adentro de cada casa
 * está en su página.
 *
 * Abre con un hero a pantalla completa (como el inicio y las cabañas) y la nav debajo. Después,
 * tres grupos con la cabeza de los ambientes (número, nombre grande, una línea, regla fina).
 * Las fotos van **con su proporción natural, sin recortar**: hay verticales y horizontales, y
 * meter una horizontal en una caja vertical deja un pedazo que no se entiende. En escritorio,
 * tres columnas que se acomodan solas (cada una baja a su ritmo); en el celular, una por fila:
 * las horizontales a todo el ancho y las verticales un poco más angostas, alternando el lado.
 * Tocar una foto la abre en grande y se recorre el grupo con las flechas.
 */
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import CabanaHero from '../components/CabanaHero.astro';
import Franja from '../components/Franja.astro';
import Ampliable from '../components/Ampliable.astro';
import hero from '../assets/galeria/hero.jpg';
import heroVertical from '../assets/galeria/hero-vertical.jpg';

const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/galeria/*.jpg', { eager: true });
const foto = (nombre: string, alt: string) => ({ src: archivos[`../assets/galeria/${nombre}.jpg`].default, alt });

const grupos = [
  {
    titulo: 'El parque',
    texto: 'Tres mil metros de parque, con árboles frutales y nativos, flores y senderos entre las dos casas.',
    fotos: [
      foto('parque-sumac', 'El parque con Sumac Mayu entre los algarrobos, el fogón y la pileta al fondo'),
      foto('parque-flores', 'Flores amarillas silvestres en el pasto del parque'),
      foto('parque-tunas', 'El camino de ladrillo hacia Misky Wayra, entre dos grandes tunas'),
      foto('parque-ventanal', 'El ventanal de Sumac Mayu entre las ramas y las flores del jardín'),
      foto('parque-frutas', 'Frutos verdes en una rama, con Sumac Mayu desenfocada detrás'),
    ],
  },
  {
    titulo: 'La pileta',
    texto: 'La pileta de temporada, con su escalera de piedra, el deck y los cerros de fondo.',
    fotos: [
      foto('pileta-simetrica', 'La pileta con los escalones de piedra y la pérgola del deck al fondo'),
      foto('pileta-cerro', 'La pileta y el parque, con el Cerro Uritorco detrás'),
      foto('pileta-sumac', 'La pileta con Sumac Mayu detrás'),
      foto('pileta-flores', 'La pileta y el deck vistos entre flores'),
      foto('pileta-ventanal', 'El ventanal de Sumac Mayu y la glorieta, desde el borde de la pileta'),
    ],
  },
  {
    titulo: 'El fogón y las pérgolas',
    texto: 'El fogón de piedra, la parrilla y las glorietas, para estar afuera a la sombra.',
    fotos: [
      foto('fogon-rosas', 'El fogón de piedra, un farol y rosas rojas, con Sumac Mayu y la pileta detrás'),
      foto('fogon-sillones', 'Sillones bajo la glorieta de hierro, a la sombra de un olivo'),
      foto('fogon-glorieta', 'La glorieta de hierro cubierta de plantas, con sillones, frente a Sumac Mayu'),
      foto('fogon-brasero', 'El brasero y la parrilla junto a la glorieta, al lado de Sumac Mayu'),
    ],
  },
];
---

<Base
  title="Galería de fotos: Misky Wayra, Capilla del Monte"
  description="Fotos del parque, la pileta, el fogón y las pérgolas de las cabañas Misky Wayra, frente al Uritorco en Capilla del Monte, Córdoba."
  imagen={{ src: hero, alt: 'La pileta y el deck de Misky Wayra vistos entre flores' }}
>
  <CabanaHero
    nombre="Galería"
    significado="Misky Wayra · El parque"
    frase="El parque, la pileta, el fogón y las pérgolas. Las casas por dentro están en la página de cada una."
    foto={{ src: hero, vertical: heroVertical, alt: 'La pileta y el deck de Misky Wayra vistos entre flores', encuadre: '45% 55%' }}
    transicion="hero-galeria"
  />
  <Franja />

  {
    grupos.map((grupo, i) => {
      let verticales = 0;
      return (
        <section class="grupo" aria-labelledby={`grupo-${i}`}>
          <header class="cabeza" data-revelar>
            <p class="numero">{String(i + 1).padStart(2, '0')}</p>
            <h2 id={`grupo-${i}`}>{grupo.titulo}</h2>
            <p class="texto">{grupo.texto}</p>
          </header>

          <ul class="fotos" data-galeria>
            {grupo.fotos.map((f, j) => {
              const vertical = f.src.height > f.src.width;
              // En el celular, las verticales alternan de lado
              const lado = vertical ? (verticales++ % 2 === 0 ? 'derecha' : 'izquierda') : '';
              return (
                <li
                  class:list={['foto', vertical ? 'vertical' : 'horizontal', lado]}
                  style={`aspect-ratio: ${f.src.width} / ${f.src.height}; --retraso: ${(j % 3) * 0.1}s`}
                  data-revelar="foto"
                >
                  <Ampliable
                    foto={f}
                    widths={[400, 550, 700, 1000, 1200]}
                    sizes={`(min-width: 72rem) 23rem, (min-width: 48rem) 30vw, ${vertical ? '78vw' : 'calc(100vw - 2rem)'}`}
                  />
                </li>
              );
            })}
          </ul>
        </section>
      );
    })
  }
</Base>

<script>
  import '../scripts/revelar';
  import '../scripts/lightbox';
</script>

<style>
  section {
    --margen: max(var(--gutter), (100vw - var(--axis-width)) / 2);

    padding-inline: var(--margen);
    text-align: start;
  }

  section :global(p) {
    margin-inline: 0;
  }

  /* ---------- Cada grupo: la cabeza, como en los ambientes ---------- */
  .grupo {
    padding-block: var(--space-2xl);
  }

  .cabeza {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: var(--space-2xs) var(--space-m);
    padding-block-end: var(--space-m);
    border-block-end: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
  }

  .numero {
    padding-block-end: 0.5rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--color-primary);
  }

  h2 {
    font-size: clamp(2.4rem, 1.2rem + 3.6vw, 4.5rem);
    line-height: 1;
    color: var(--color-text);
  }

  .texto {
    grid-column: 1 / -1;
    max-width: 30rem;
  }

  @media (width >= 64rem) {
    .cabeza {
      grid-template-columns: auto 1fr minmax(0, 24rem);
    }

    .texto {
      grid-column: auto;
      padding-block-end: 0.4rem;
    }
  }

  /* ---------- Las fotos, con su proporción natural ----------
     Celular: una por fila; las horizontales a todo el ancho, las verticales al 78% y alternando
     de lado (el ritmo de antes, sin recortar ninguna). */
  .fotos {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-l);
    padding: 0;
    list-style: none;
  }

  .foto {
    margin: 0;
    overflow: hidden;
    background: var(--color-surface);
  }

  .foto.vertical {
    width: 78%;
  }

  .foto.derecha {
    justify-self: end;
  }

  /* Escritorio: tres columnas que se llenan de arriba a abajo; con verticales y horizontales
     mezcladas, cada columna baja a su ritmo (el escalonado sale solo) */
  @media (width >= 48rem) {
    .fotos {
      display: block;
      columns: 3;
      column-gap: clamp(1rem, 2.2vw, 2rem);
    }

    .foto,
    .foto.vertical {
      width: auto;
      margin-block-end: clamp(1rem, 2.2vw, 2rem);
      break-inside: avoid;
    }
  }

  .foto :global(picture),
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Al pasar el mouse, la foto se acerca despacio */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .foto :global(img) {
      transition: scale 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .foto:hover :global(img) {
      scale: 1.04;
    }
  }
</style>
