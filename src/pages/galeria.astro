---
/**
 * Galería de fotos: el parque, la pileta, el fogón y las pérgolas. Lo de adentro de cada casa
 * está en su página.
 *
 * Abre con un hero a pantalla completa (como el inicio y las cabañas) y la nav debajo. Después,
 * sin texto, un mosaico con todas las fotos **con su proporción natural, sin recortar** (meter
 * una horizontal en una caja vertical deja un pedazo que no se entiende). Tocar una foto la abre
 * en grande y se recorren todas con las flechas.
 */
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import CabanaHero from '../components/CabanaHero.astro';
import Franja from '../components/Franja.astro';
import Ampliable from '../components/Ampliable.astro';
import hero from '../assets/galeria/hero.jpg';
import heroVertical from '../assets/galeria/hero-vertical.jpg';

const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/galeria/*.jpg', { eager: true });
const foto = (nombre: string, alt: string) => ({ src: archivos[`../assets/galeria/${nombre}.jpg`].default, alt });

/** Texto alternativo de cada foto */
const alts: Record<string, string> = {
  // La sesión de noviembre (cámara, día nublado)
  'parque-sumac': 'El parque con Sumaq Mayu entre los algarrobos, el fogón y la pileta al fondo',
  'pileta-simetrica': 'La pileta con los escalones de piedra y la pérgola del deck al fondo',
  'parque-flores': 'Flores amarillas silvestres en el pasto del parque',
  'fogon-glorieta': 'La glorieta de hierro cubierta de plantas, con sillones, frente a Sumaq Mayu',
  'parque-tunas': 'El camino de ladrillo hacia Misky Wayra, entre dos grandes tunas',
  'pileta-cerro': 'La pileta y el parque, con el Cerro Uritorco detrás',
  'fogon-sillones': 'Sillones bajo la glorieta de hierro, a la sombra de un olivo',
  'pileta-sumac': 'La pileta con Sumaq Mayu detrás',
  'parque-ventanal': 'El ventanal de Sumaq Mayu entre las ramas y las flores del jardín',
  'fogon-rosas': 'El fogón de piedra, un farol y rosas rojas, con Sumaq Mayu y la pileta detrás',
  'pileta-flores': 'La pileta y el deck vistos entre flores',
  'parque-frutas': 'Frutos verdes en una rama, con Sumaq Mayu desenfocada detrás',
  'fogon-brasero': 'El brasero y la parrilla junto a la glorieta, al lado de Sumaq Mayu',
  'pileta-ventanal': 'El ventanal de Sumaq Mayu y la glorieta, desde el borde de la pileta',
  // La primera entrega (con sol, más cálidas; 1080 px)
  deck_01: 'Reposeras sobre el deck, bajo una pérgola, junto a la pileta',
  fogon_01: 'El fogón rodeado de piedras, bajo un árbol grande',
  fogon_02: 'El fogón con bancos de madera y hierro sobre el ripio, con la pileta al fondo',
  jardin_02: 'La parrilla y un brasero bajo los árboles, junto a una glorieta de hierro',
  jardin_03: 'Rosas rojas en primer plano y Sumaq Mayu desenfocada al fondo, junto a la pileta',
  jardin_04: 'Flores lilas en primer plano y la cúpula de Sumaq Mayu desenfocada detrás de los árboles',
  jardin_05: 'Flores rojas y el tronco de un árbol en primer plano, con la pileta al fondo',
  jardin_06: 'Flores lilas frente a la pileta, con las sierras al fondo',
  jardin_08: 'Pérgola de hierro en arco sobre el pasto, con Sumaq Mayu al fondo',
  jardin_09: 'Sumaq Mayu entre los árboles del parque, con flores lilas en primer plano',
  jardin_10: 'Sillones bajo una pérgola cubierta de plantas',
  jardin_11: 'El Cerro Uritorco detrás de la pileta y su muro de piedra',
  jardin_12: 'Sendero de piedras entre el pasto y los canteros con flores, a la sombra de los árboles del parque',
  jardin_13: 'Sillones a la sombra de una glorieta de hierro con plantas',
  jardin_14: 'Cantero con un agave, flores y piedras, con el tanque de agua detrás',
  jardin_15: 'Agaves y flores bajo los árboles, junto a un portón de madera',
  pileta_01: 'La pileta y el deck de madera con sillones, bajo una pérgola',
  pileta_02: 'La pileta con Sumaq Mayu detrás',
  pileta_03: 'Un sillón de madera en el deck junto a la pileta, con Sumaq Mayu de fondo',
};

// Mosaico armado a mano: tres columnas de 11 fotos (8 verticales y 3 horizontales cada una, así
// miden casi lo mismo), con las horizontales a distinta altura en cada columna, y las fotos con
// sol y las nubladas mezcladas para que ningún tono se agrupe. Si sobra diferencia, cada columna
// se centra en la más alta (mitad del desfase arriba, mitad abajo).
const disposicion = [
  ['jardin_03', 'parque-flores', 'pileta-simetrica', 'jardin_12', 'jardin_09', 'fogon_01', 'fogon-rosas', 'jardin_14', 'jardin_06', 'parque-frutas', 'deck_01'],
  ['pileta-sumac', 'jardin_11', 'jardin_08', 'parque-sumac', 'fogon-glorieta', 'jardin_04', 'pileta_03', 'jardin_13', 'parque-tunas', 'jardin_15', 'fogon-sillones'],
  ['jardin_10', 'pileta_02', 'jardin_02', 'parque-ventanal', 'pileta-cerro', 'fogon_02', 'pileta-flores', 'fogon-brasero', 'pileta_01', 'jardin_05', 'pileta-ventanal'],
];

// El orden de recorrido (y el del celular): por filas, de izquierda a derecha
const nombres = disposicion[0].flatMap((_, fila) => disposicion.map((col) => col[fila]));
const fotos = nombres.map((n) => foto(n, alts[n]));
const indice = (n: string) => nombres.indexOf(n);

const HUECO = 0.075; // el espacio entre fotos, en anchos de columna (2rem sobre ~430px)
const altoDe = (i: number) => fotos[i].src.height / fotos[i].src.width + HUECO;
const indices = disposicion.map((col) => col.map(indice));
const altos = indices.map((col) => col.reduce((t, i) => t + altoDe(i), 0));
const maximo = Math.max(...altos);
const columnas = indices.map((col, c) => ({
  desfase: +((maximo - altos[c]) / 2).toFixed(3), // en anchos de columna
  fotos: col.map((i) => ({ f: fotos[i], i })),
}));
---

<Base
  title="Galería de fotos: Misky Wayra, Capilla del Monte"
  description="Fotos del parque, la pileta, el fogón y las pérgolas de las cabañas Misky Wayra, frente al Uritorco en Capilla del Monte, Córdoba."
  imagen={{ src: hero, alt: 'La pileta y el deck de Misky Wayra vistos entre flores' }}
>
  <CabanaHero
    nombre="Galería"
    significado="Misky Wayra · El parque"
    frase="El parque, la pileta, el fogón y las pérgolas. Las casas por dentro están en la página de cada una."
    foto={{ src: hero, vertical: heroVertical, alt: 'La pileta y el deck de Misky Wayra vistos entre flores', encuadre: '45% 55%' }}
    transicion="hero-galeria"
  />
  <Franja />

  <section class="mosaico" aria-label="Fotos del parque, la pileta y el fogón">
    <div class="columnas" data-galeria>
      {
        columnas.map((col) => (
          <div class="columna" style={`--desfase: ${col.desfase}`}>
            {col.fotos.map(({ f, i }) => {
              const vertical = f.src.height > f.src.width;
              return (
                <figure
                  class:list={['foto', vertical ? 'vertical' : 'horizontal']}
                  style={`aspect-ratio: ${f.src.width} / ${f.src.height}; order: ${i}`}
                  data-revelar="foto"
                >
                  <Ampliable
                    foto={f}
                    widths={vertical ? [400, 550, 700, 1000, 1200] : [400, 550, 700, 1000, 1200, 1600, 2000]}
                    // En el celular todas van 4:5: una horizontal se ve al ~1.9× del ancho de la caja
                    sizes={`(min-width: 72rem) 23rem, (min-width: 48rem) 30vw, ${vertical ? 'calc(100vw - 2rem)' : 'calc((100vw - 2rem) * 1.9)'}`}
                  />
                </figure>
              );
            })}
          </div>
        ))
      }
    </div>
  </section>
</Base>

<script>
  import '../scripts/revelar';
  import '../scripts/lightbox';
</script>

<style>
  section {
    --margen: max(var(--gutter), (100vw - var(--axis-width)) / 2);

    padding-inline: var(--margen);
    text-align: start;
  }

  section :global(p) {
    margin-inline: 0;
  }

  /* ---------- El mosaico ----------
     Escritorio: tres columnas armadas en el build, con el mismo espacio en las dos direcciones.
     Celular: una sola columna en el orden original (las columnas se disuelven y `order` ordena),
     todas las fotos a todo el ancho y del mismo tamaño. */
  .mosaico {
    --hueco: clamp(1rem, 2.2vw, 2rem);

    padding-block: var(--space-3xl);
  }

  .columnas {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .columna {
    display: contents;
  }

  .foto {
    margin: 0;
    overflow: hidden;
    background: var(--color-surface);
  }

  /* Celular: todas del mismo tamaño al bajar (4:5, como los carruseles de las cabañas); al
     tocarla, cada una se abre entera, con su proporción */
  @media (width < 48rem) {
    .foto {
      aspect-ratio: 4 / 5 !important;
    }
  }

  @media (width >= 48rem) {
    .columnas {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--hueco);
    }

    .columna {
      /* el desfase está en anchos de columna; el % del margen es del ancho de la grilla */
      margin-block-start: calc(var(--desfase) * (100% - 2 * var(--hueco)) / 3);
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: var(--hueco);
      min-width: 0;
    }

    .foto {
      order: 0 !important;
    }
  }

  .foto :global(picture),
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Al pasar el mouse, la foto se acerca despacio */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .foto :global(img) {
      transition: scale 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .foto:hover :global(img) {
      scale: 1.04;
    }
  }
</style>
