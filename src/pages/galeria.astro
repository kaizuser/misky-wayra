---
/**
 * Galería de fotos: el parque, la pileta, el fogón y las pérgolas. Lo de adentro de cada casa
 * está en su página.
 *
 * Abre con un hero a pantalla completa (como el inicio y las cabañas) y la nav debajo. Después,
 * sin texto, un mosaico con todas las fotos **con su proporción natural, sin recortar** (meter
 * una horizontal en una caja vertical deja un pedazo que no se entiende). Tocar una foto la abre
 * en grande y se recorren todas con las flechas.
 */
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import CabanaHero from '../components/CabanaHero.astro';
import Franja from '../components/Franja.astro';
import Ampliable from '../components/Ampliable.astro';
import hero from '../assets/galeria/hero.jpg';
import heroVertical from '../assets/galeria/hero-vertical.jpg';

const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/galeria/*.jpg', { eager: true });
const foto = (nombre: string, alt: string) => ({ src: archivos[`../assets/galeria/${nombre}.jpg`].default, alt });

/** Todas las fotos, en el orden en que se recorren (mezclando parque, pileta y fogón) */
const fotos = [
  foto('parque-sumac', 'El parque con Sumac Mayu entre los algarrobos, el fogón y la pileta al fondo'),
  foto('pileta-simetrica', 'La pileta con los escalones de piedra y la pérgola del deck al fondo'),
  foto('parque-flores', 'Flores amarillas silvestres en el pasto del parque'),
  foto('fogon-glorieta', 'La glorieta de hierro cubierta de plantas, con sillones, frente a Sumac Mayu'),
  foto('parque-tunas', 'El camino de ladrillo hacia Misky Wayra, entre dos grandes tunas'),
  foto('pileta-cerro', 'La pileta y el parque, con el Cerro Uritorco detrás'),
  foto('fogon-sillones', 'Sillones bajo la glorieta de hierro, a la sombra de un olivo'),
  foto('pileta-sumac', 'La pileta con Sumac Mayu detrás'),
  foto('parque-ventanal', 'El ventanal de Sumac Mayu entre las ramas y las flores del jardín'),
  foto('fogon-rosas', 'El fogón de piedra, un farol y rosas rojas, con Sumac Mayu y la pileta detrás'),
  foto('pileta-flores', 'La pileta y el deck vistos entre flores'),
  foto('parque-frutas', 'Frutos verdes en una rama, con Sumac Mayu desenfocada detrás'),
  foto('fogon-brasero', 'El brasero y la parrilla junto a la glorieta, al lado de Sumac Mayu'),
  foto('pileta-ventanal', 'El ventanal de Sumac Mayu y la glorieta, desde el borde de la pileta'),
];

// Mosaico armado a mano: casi todas las fotos son 2:3 o 3:2, así que ninguna combinación deja las
// columnas parejas, y la que más se acerca apila horizontales (monótono). Las columnas alternan
// verticales y horizontales; los costados miden lo mismo y el del medio es más alto: cada columna
// se centra en la altura del medio (mitad del desfase arriba, mitad abajo), un escalonado simétrico.
const porNombre = (n: string) => fotos.findIndex((f) => f.src.src.includes(`/${n}.`));
const disposicion = [
  ['parque-sumac', 'pileta-simetrica', 'fogon-sillones', 'fogon-rosas'],
  ['pileta-sumac', 'parque-flores', 'fogon-glorieta', 'pileta-flores', 'parque-tunas'],
  ['parque-ventanal', 'parque-frutas', 'pileta-cerro', 'fogon-brasero', 'pileta-ventanal'],
];
const HUECO = 0.075; // el espacio entre fotos, en anchos de columna (2rem sobre ~430px)
const altoDe = (i: number) => fotos[i].src.height / fotos[i].src.width + HUECO;
const indices = disposicion.map((col) => col.map(porNombre));
const altos = indices.map((col) => col.reduce((t, i) => t + altoDe(i), 0));
const maximo = Math.max(...altos);
const columnas = indices.map((col, c) => ({
  desfase: +((maximo - altos[c]) / 2).toFixed(3), // en anchos de columna
  fotos: col.map((i) => ({ f: fotos[i], i })),
}));
---

<Base
  title="Galería de fotos: Misky Wayra, Capilla del Monte"
  description="Fotos del parque, la pileta, el fogón y las pérgolas de las cabañas Misky Wayra, frente al Uritorco en Capilla del Monte, Córdoba."
  imagen={{ src: hero, alt: 'La pileta y el deck de Misky Wayra vistos entre flores' }}
>
  <CabanaHero
    nombre="Galería"
    significado="Misky Wayra · El parque"
    frase="El parque, la pileta, el fogón y las pérgolas. Las casas por dentro están en la página de cada una."
    foto={{ src: hero, vertical: heroVertical, alt: 'La pileta y el deck de Misky Wayra vistos entre flores', encuadre: '45% 55%' }}
    transicion="hero-galeria"
  />
  <Franja />

  <section class="mosaico" aria-label="Fotos del parque, la pileta y el fogón">
    <div class="columnas" data-galeria>
      {
        columnas.map((col) => (
          <div class="columna" style={`--desfase: ${col.desfase}`}>
            {col.fotos.map(({ f, i }) => {
              const vertical = f.src.height > f.src.width;
              return (
                <figure
                  class:list={['foto', vertical ? 'vertical' : 'horizontal', i % 2 ? 'izquierda' : 'derecha']}
                  style={`aspect-ratio: ${f.src.width} / ${f.src.height}; order: ${i}`}
                  data-revelar="foto"
                >
                  <Ampliable
                    foto={f}
                    widths={[400, 550, 700, 1000, 1200]}
                    sizes={`(min-width: 72rem) 23rem, (min-width: 48rem) 30vw, ${vertical ? '78vw' : 'calc(100vw - 2rem)'}`}
                  />
                </figure>
              );
            })}
          </div>
        ))
      }
    </div>
  </section>
</Base>

<script>
  import '../scripts/revelar';
  import '../scripts/lightbox';
</script>

<style>
  section {
    --margen: max(var(--gutter), (100vw - var(--axis-width)) / 2);

    padding-inline: var(--margen);
    text-align: start;
  }

  section :global(p) {
    margin-inline: 0;
  }

  /* ---------- El mosaico ----------
     Escritorio: tres columnas armadas en el build, con el mismo espacio en las dos direcciones.
     Celular: una sola columna en el orden original (las columnas se disuelven y `order` ordena):
     horizontales a todo el ancho, verticales al 78% alternando el lado. */
  .mosaico {
    --hueco: clamp(1rem, 2.2vw, 2rem);

    padding-block: var(--space-3xl);
  }

  .columnas {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .columna {
    display: contents;
  }

  .foto {
    margin: 0;
    overflow: hidden;
    background: var(--color-surface);
  }

  .foto.vertical {
    width: 78%;
  }

  .foto.vertical.derecha {
    align-self: flex-end;
  }

  @media (width >= 48rem) {
    .columnas {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--hueco);
    }

    .columna {
      /* el desfase está en anchos de columna; el % del margen es del ancho de la grilla */
      margin-block-start: calc(var(--desfase) * (100% - 2 * var(--hueco)) / 3);
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: var(--hueco);
      min-width: 0;
    }

    .foto,
    .foto.vertical,
    .foto.vertical.derecha {
      width: auto;
      align-self: stretch;
      order: 0 !important;
    }
  }

  .foto :global(picture),
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Al pasar el mouse, la foto se acerca despacio */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .foto :global(img) {
      transition: scale 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .foto:hover :global(img) {
      scale: 1.04;
    }
  }
</style>
