---
import Base from '../layouts/Base.astro';
---

<!--
  Galería de fotos: todo lo que no está en la página de cada cabaña.
  El parque, la pileta, los espacios compartidos y las vistas.
  Boceto: las fotos se suman con `page-galeria` (fotos en src/assets/galeria/).
-->
<Base
  title="Galería de fotos: Misky Wayra, Capilla del Monte"
  description="[Descripción de 150 caracteres para Google]"
>
  <section class="hero">
    <h1>Galería de fotos</h1>
    <p>[Una frase: el parque, la pileta y el monte que rodea a las dos casas]</p>
  </section>

  <section>
    <h2>El parque</h2>
    <p>[Fotos del parque: algarrobos, olivo, agaves, senderos]</p>
  </section>

  <section>
    <h2>La pileta</h2>
    <p>[Fotos de la pileta y los decks]</p>
  </section>

  <section>
    <h2>Los espacios compartidos</h2>
    <p>[Fogón, parrilla, glorieta con jazmín, pérgola con parra]</p>
  </section>

  <section>
    <h2>Las vistas</h2>
    <p>[El Uritorco y las sierras desde el parque]</p>
  </section>
</Base>
