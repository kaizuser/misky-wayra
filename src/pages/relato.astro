---
/**
 * El relato en secciones, mientras se muda al home: la historia de las dos casas contada con
 * fotos (trío, cinco, cruz, escalones, notas). Por ahora con el contenido de Sumac. Página interna,
 * sin indexar y sin links; se borra cuando el relato esté en el home.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Secciones from '../components/Secciones.astro';

const sumac = (await getEntry('cabanas', 'sumac-mayu'))!;
---

<Base title="El relato (borrador) · Misky Wayra" description="Borrador interno del relato." theme="mayu" noindex>
  <Secciones principal={sumac.data.principal} paradas={sumac.data.recorrido} />
</Base>
