---
import Base from '../layouts/Base.astro';
---

<Base
  title="Ubicación y contacto: Misky Wayra, Capilla del Monte"
  description="[Descripción de 150 caracteres para Google]"
>
  <section class="hero">
    <h1>Ubicación y contacto</h1>
  </section>

  <section class="ubicacion">
    <h2>Dónde estamos</h2>
    <address>[Dirección], Capilla del Monte, Córdoba</address>
    <div>[mapa estático]</div>
    <a href="https://maps.google.com/?q=[coordenadas]">Abrir en Google Maps</a>
  </section>

  <section class="como-llegar">
    <h2>Cómo llegar</h2>
    <p>[Indicaciones desde Córdoba capital]</p>
  </section>

  <section class="contacto">
    <h2>Contacto</h2>
    <ul>
      <li><a href="https://wa.me/549XXXXXXXXXX">WhatsApp</a></li>
      <li><a href="tel:+549XXXXXXXXXX">[Teléfono]</a></li>
      <li><a href="https://instagram.com/[usuario]">Instagram</a></li>
    </ul>
  </section>
</Base>
