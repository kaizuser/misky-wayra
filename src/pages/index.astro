---
/**
 * El inicio: el relato. La casa a pantalla completa, la franja de navegación y la historia de
 * las cabañas contada con fotos (Secciones: trío, cinco, cruz, escalones, notas).
 * Por ahora con el contenido de Sumac; cuando estén las fotos y los textos, cuenta las dos casas:
 * cómo empezó todo en Misky Wayra, cómo llegó Sumac Mayu, el parque y los alrededores.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CabanaHero from '../components/CabanaHero.astro';
import Franja from '../components/Franja.astro';
import Secciones from '../components/Secciones.astro';
import Elegir from '../components/Elegir.astro';
import { negocio } from '../lib/datos';
import hero from '../assets/home/hero.jpg';
import { principal, paradas } from '../data/relato';

const cabanas = (await getCollection('cabanas')).sort((a, b) => a.data.orden - b.data.orden);
---

<Base
  title="Misky Wayra: cabañas de adobe en Capilla del Monte"
  description="Dos cabañas de adobe hechas a mano en Capilla del Monte, Córdoba, en un parque de 3.000 m² con vista al Uritorco. Consultá disponibilidad por WhatsApp."
  jsonLd={negocio(cabanas, Astro.site!)}
  cabecera={false}
>
  <!-- Foto provisoria: el parque y la pileta con el Uritorco -->
  <CabanaHero
    nombre="Misky Wayra"
    significado="Capilla del Monte · Córdoba"
    frase="Dos cabañas de adobe hechas a mano, en un parque frente al Uritorco."
    foto={{
      src: hero,
      alt: 'El parque de Misky Wayra con la pileta, el deck y el Cerro Uritorco detrás',
      encuadre: '50% 60%',
    }}
    transicion="hero-inicio"
  />
  <Franja />
  <Secciones principal={principal} paradas={paradas} />
  <Elegir />
</Base>
