---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Alero from '../components/Alero.astro';
import Hero from '../components/Hero.astro';
import Encuentro from '../components/Encuentro.astro';
import Consultar from '../components/Consultar.astro';
import { SITIO, mapsUrl } from '../config';
import { feston } from '../lib/formas';
import { negocio } from '../lib/datos';

// Frente a frente: Sumac a la izquierda (orden 1), Misky a la derecha (orden 2)
const cabanas = (await getCollection('cabanas')).sort((a, b) => a.data.orden - b.data.orden);
const [izquierda, derecha] = cabanas;

const filas = [
  { nombre: 'Superficie', dato: (c: typeof izquierda) => `${c.data.datos.superficie} m²` },
  { nombre: 'Huéspedes', dato: (c: typeof izquierda) => c.data.datos.huespedes },
  { nombre: 'Dormitorios', dato: (c: typeof izquierda) => String(c.data.datos.dormitorios) },
  { nombre: 'Camas', dato: (c: typeof izquierda) => c.data.datos.camas },
  { nombre: 'Lo propio', dato: (c: typeof izquierda) => c.data.propio },
];

const compartido = [
  'La pileta, en temporada',
  'los decks',
  'el fogón',
  'la parrilla',
  'la glorieta de jazmín',
  'la pérgola con la parra',
  'los frutales y los algarrobos',
  'la vista al Uritorco',
];

const borde = feston(24, 92);
---

<Base
  title="Misky Wayra: cabañas de adobe en Capilla del Monte"
  description="Dos cabañas de adobe hechas a mano en Capilla del Monte, Córdoba, en un parque de 3.000 m² con vista al Uritorco. Consultá disponibilidad por WhatsApp."
  jsonLd={negocio(cabanas, Astro.site!)}
>
  <Hero />

  <!-- El complejo: el centro del eje -->
  <Alero />
  <section class="complejo banda">
    <Encuentro />
    <h2>Entre las dos, el parque</h2>
    <p>
      Las dos casas comparten un parque de 3.000 m² en Barrio Valentí, con frutales y árboles
      autóctonos, y una vista abierta a los cerros. En temporada, también la pileta.
    </p>
  </section>
  <Alero flip />

  <!-- Las dos casas, espejadas sobre el eje -->
  <section class="frente" aria-labelledby="frente-titulo">
    <h2 id="frente-titulo">Frente a frente</h2>
    <table>
      <thead>
        <tr>
          <th scope="col" data-theme={izquierda.data.tema}>
            <svg class="ventanita" viewBox="0 0 40 50" aria-hidden="true">
              <path d="M2,48 V20 A18,18 0 0 1 38,20 V48 Z" />
              <path class="parante" d="M20,4 V48" />
            </svg>
            <span class="nombre">{izquierda.data.nombre}</span>
            <span class="significado">{izquierda.data.significado}</span>
          </th>
          <td></td>
          <th scope="col" data-theme={derecha.data.tema}>
            <svg class="ventanita redonda" viewBox="-12 -12 224 224" aria-hidden="true">
              <path d={borde} />
            </svg>
            <span class="nombre">{derecha.data.nombre}</span>
            <span class="significado">{derecha.data.significado}</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {
          filas.map((fila) => (
            <tr>
              <td>{fila.dato(izquierda)}</td>
              <th scope="row">{fila.nombre}</th>
              <td>{fila.dato(derecha)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="conocer">
      <a href={`/cabanas/${izquierda.id}/`} data-theme={izquierda.data.tema}>Conocer {izquierda.data.nombre}</a>
      <a href={`/cabanas/${derecha.id}/`} data-theme={derecha.data.tema}>Conocer {derecha.data.nombre}</a>
    </p>
  </section>

  <!-- Lo que comparten: el anticipo de la galería -->
  <section class="compartido">
    <h2>Lo que comparten</h2>
    <ul>
      {compartido.map((espacio) => <li>{espacio}</li>)}
    </ul>
    <a href="/galeria/">Ver la galería de fotos</a>
  </section>

  <Alero />
  <Consultar
    class="banda"
    titulo="¿Cuándo venís?"
    mensaje="Hola! Quería consultar disponibilidad en las cabañas para "
    boton="Escribinos por WhatsApp"
  >
    <p class="direccion">
      Estamos en {SITIO.direccion}, {SITIO.localidad}. <a href={mapsUrl}>Cómo llegar</a>
    </p>
  </Consultar>
</Base>

<style>
  /* ---------- El complejo ---------- */
  .complejo p {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 34ch;
  }

  /* ---------- Frente a frente ---------- */
  table {
    width: min(100%, 52rem);
    margin-inline: auto;
    margin-block-start: var(--space-xl);
    border-collapse: collapse;
  }

  thead th {
    padding: 0 var(--space-xl) var(--space-l);
    vertical-align: bottom;
    color: var(--color-primary);
  }

  /* Los nombres, como los datos, se alinean hacia el eje */
  thead th:first-child { text-align: end; }
  thead th:last-child { text-align: start; }

  .ventanita {
    width: 2.25rem;
    height: auto;
    margin-block-end: var(--space-2xs);
  }

  thead th:first-child .ventanita { margin-inline-start: auto; }

  .ventanita path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .ventanita .parante {
    stroke-width: 1.5;
  }

  .ventanita.redonda path {
    stroke-width: 8;
  }

  thead .nombre,
  thead .significado {
    display: block;
  }

  thead .nombre {
    font-family: var(--font-display);
    font-weight: var(--peso-titulo);
    font-size: var(--step-2);
    line-height: 1.1;
  }

  thead .significado {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-deep);
  }

  /* Cada dato se alinea hacia el eje; el nombre de la fila va en el centro */
  tbody td {
    width: 40%;
    padding: var(--space-m) var(--space-xl);
    border-block-start: 1px solid var(--color-surface);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
  }

  tbody td:first-child {
    text-align: end;
  }

  tbody td:last-child {
    text-align: start;
  }

  tbody th {
    padding: var(--space-m) var(--space-2xs);
    border-block-start: 1px solid var(--color-surface);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .conocer {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-xl);
    max-width: none;
    margin-block-start: var(--space-xl);
  }

  .conocer a {
    font-family: var(--font-display);
    font-weight: var(--peso-titulo);
    font-size: var(--step-1);
  }

  .conocer a:first-child::before { content: '← '; }
  .conocer a:last-child::after { content: ' →'; }

  @media (width < 40rem) {
    thead th,
    tbody td {
      padding-inline: var(--space-2xs);
    }

    tbody td {
      font-size: var(--step-0);
      padding-block: var(--space-s);
    }

    tbody th {
      padding-block: var(--space-s);
    }

    tbody th {
      white-space: normal;
      letter-spacing: 0.06em;
    }
  }

  /* ---------- Lo que comparten ---------- */
  .compartido ul {
    max-width: 40rem;
    margin-inline: auto;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 300;
    line-height: 1.4;
  }

  .compartido li {
    display: inline;
  }

  .compartido li:not(:last-child)::after {
    content: ' · ';
    color: var(--color-primary);
  }

  .compartido li:last-child::after {
    content: '.';
  }

  /* ---------- Contacto ---------- */
  .direccion {
    font-size: var(--step-0);
  }
</style>
