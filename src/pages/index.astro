---
import Base from '../layouts/Base.astro';
import Alero from '../components/Alero.astro';
import Hero from '../components/Hero.astro';
import { whatsappUrl } from '../config';
---

<Base
  title="Misky Wayra: cabañas de adobe en Capilla del Monte"
  description="[Descripción de 150 caracteres para Google]"
>
  <Hero />

  <section class="complejo banda">
    <h2>El complejo</h2>
    <p>[La tierra, el adobe, quiénes somos, los espacios compartidos]</p>
  </section>
  <Alero flip />

  <section class="cabanas">
    <h2>Nuestras cabañas</h2>

    <article data-theme="mayu">
      <h3>Sumac Mayu</h3>
      <p>[Río hermoso: una frase sobre esta cabaña]</p>
      <a href="/cabanas/sumac-mayu">Conocer Sumac Mayu</a>
    </article>

    <article data-theme="wayra">
      <h3>Misky Wayra</h3>
      <p>[Viento dulce: una frase sobre esta cabaña]</p>
      <a href="/cabanas/misky-wayra">Conocer Misky Wayra</a>
    </article>
  </section>

  <section class="comparacion">
    <h2>Las dos cabañas de un vistazo</h2>
    <!-- Mirrored table: attribute in the center, one cottage per side -->
    <table>
      <thead>
        <tr>
          <th scope="col">Sumac Mayu</th>
          <td></td>
          <th scope="col">Misky Wayra</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>[x]</td><th scope="row">Huéspedes</th><td>[x]</td></tr>
        <tr><td>[x]</td><th scope="row">Dormitorios</th><td>[x]</td></tr>
        <tr><td>[x]</td><th scope="row">Camas</th><td>[x]</td></tr>
      </tbody>
    </table>
  </section>

  <section class="galeria">
    <h2>El parque</h2>
    <p>[Tres mil metros cuadrados de monte, la pileta y los espacios compartidos]</p>
    <a href="/galeria">Ver la galería de fotos</a>
  </section>

  <Alero />
  <section class="contacto banda">
    <h2>Consultá disponibilidad</h2>
    <a href={whatsappUrl('Hola! Quería consultar disponibilidad en Misky Wayra')}>Escribinos por WhatsApp</a>
  </section>
</Base>
