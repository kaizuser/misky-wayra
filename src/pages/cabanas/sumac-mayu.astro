---
import Base from '../../layouts/Base.astro';

const whatsapp =
  'https://wa.me/549XXXXXXXXXX?text=' +
  encodeURIComponent('Hola! Quería consultar disponibilidad en Sumac Mayu para ');
---

<Base
  title="Sumac Mayu: cabaña de adobe en Capilla del Monte"
  description="[Descripción de 150 caracteres para Google]"
  theme="mayu"
>
  <section class="hero">
    <div>[foto principal]</div>
    <h1>Sumac Mayu</h1>
    <p>Río hermoso</p>
  </section>

  <section class="esencia">
    <h2>La esencia</h2>
    <p>[Qué hace única a esta cabaña]</p>
  </section>

  <section class="detalles">
    <h2>Detalles</h2>
    <dl>
      <dt>Huéspedes</dt><dd>[x]</dd>
      <dt>Dormitorios</dt><dd>[x]</dd>
      <dt>Camas</dt><dd>[x]</dd>
    </dl>
    <h3>Comodidades</h3>
    <ul>
      <li>[comodidad]</li>
      <li>[comodidad]</li>
    </ul>
  </section>

  <section class="galeria">
    <h2>Fotos</h2>
    <p>[galería]</p>
  </section>

  <section class="consultar">
    <a href={whatsapp}>Consultar por Sumac Mayu</a>
  </section>

  <aside class="hermana">
    <p>Conocé también</p>
    <a href="/cabanas/misky-wayra">Misky Wayra</a>
  </aside>
</Base>
