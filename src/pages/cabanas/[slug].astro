---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CabanaHero from '../../components/CabanaHero.astro';
import Franja from '../../components/Franja.astro';
import Ficha from '../../components/Ficha.astro';
import Ambientes from '../../components/Ambientes.astro';
import Resenas from '../../components/Resenas.astro';
import Reservar from '../../components/Reservar.astro';
import OtraCasa from '../../components/OtraCasa.astro';
import { alojamiento } from '../../lib/datos';

export async function getStaticPaths() {
  const cabanas = (await getCollection('cabanas')).sort((a, b) => a.data.orden - b.data.orden);

  return cabanas.map((cabana) => ({
    params: { slug: cabana.id },
    props: {
      cabana,
      hermana: cabanas.find((otra) => otra.id !== cabana.id)!,
    },
  }));
}

interface Props {
  cabana: CollectionEntry<'cabanas'>;
  hermana: CollectionEntry<'cabanas'>;
}

const { cabana, hermana } = Astro.props;
const d = cabana.data;
---

<Base
  title={d.seoTitle}
  description={d.seoDescription}
  theme={d.tema}
  imagen={d.foto}
  jsonLd={alojamiento(cabana, Astro.site!)}
>
  <!-- 1. La llegada -->
  <CabanaHero
    nombre={d.nombre}
    significado={d.significado}
    frase={d.frase}
    foto={d.foto}
    transicion={`casa-${cabana.id}`}
  />
  <Franja />

  <!-- 2. La ficha, los ambientes, las reseñas, cómo reservar y la otra casa -->
  <Ficha datos={d.datos} equipamiento={d.equipamiento} comodidades={d.comodidades} />
  <Ambientes ambientes={d.recorrido} />
  <Resenas resenas={d.resenas} />
  <Reservar nombre={d.nombre} />
  <OtraCasa
    id={hermana.id}
    nombre={hermana.data.nombre}
    significado={hermana.data.significado}
    tema={hermana.data.tema}
    foto={hermana.data.foto}
  />
</Base>

