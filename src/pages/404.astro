---
/**
 * 404: te perdiste en el monte. El camino punteado del inicio llega a una bifurcación:
 * una rama lleva a cada casa, y abajo está la vuelta al inicio.
 */
import Base from '../layouts/Base.astro';
import { feston } from '../lib/formas';

const borde = feston(24, 92);
---

<Base
  title="Te perdiste en el monte · Misky Wayra"
  description="Esta página no existe. Volvé al inicio o seguí el camino hacia una de las dos cabañas."
  noindex
>
  <section class="perdido">
    <p class="antetitulo">Error 404</p>
    <h1>Te perdiste en el monte</h1>
    <p>Esta página no existe, o se la llevó el viento. El camino sigue por acá:</p>

    <!-- El camino se bifurca hacia las dos casas -->
    <svg class="bifurcacion" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M200,0 V40 C200,80 100,70 100,120" vector-effect="non-scaling-stroke" />
      <path d="M200,40 C200,80 300,70 300,120" vector-effect="non-scaling-stroke" />
    </svg>

    <div class="casas">
      <a href="/cabanas/sumac-mayu/" data-theme="mayu">
        <svg class="ventanita" viewBox="0 0 40 50" aria-hidden="true">
          <path d="M2,48 V20 A18,18 0 0 1 38,20 V48 Z" />
          <path d="M20,4 V48" />
        </svg>
        Sumac Mayu
      </a>
      <a href="/cabanas/misky-wayra/" data-theme="wayra">
        <svg class="ventanita redonda" viewBox="-12 -12 224 224" aria-hidden="true">
          <path d={borde} />
        </svg>
        Misky Wayra
      </a>
    </div>

    <a class="volver" href="/">Volver al inicio</a>
  </section>
</Base>

<style>
  .perdido {
    min-height: 70svh;
    display: grid;
    align-content: center;
    justify-items: center;
  }

  .antetitulo {
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  h1 {
    font-weight: 300;
  }

  .bifurcacion {
    width: min(100%, 26rem);
    height: 6rem;
    margin-block-start: var(--space-l);
    overflow: visible;
  }

  .bifurcacion path {
    fill: none;
    stroke: color-mix(in srgb, var(--color-text) 35%, transparent);
    stroke-width: 1.5;
    stroke-dasharray: 5 6;
  }

  /* Dos columnas iguales: cada casa queda centrada bajo el final de su rama (25% y 75%) */
  .casas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: min(100%, 26rem);
    margin-block-start: var(--space-2xs);
  }

  .casas a {
    display: grid;
    justify-items: center;
    gap: var(--space-2xs);
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: var(--peso-titulo);
    font-size: var(--step-1);
    text-decoration: none;
    color: var(--color-primary);
  }

  .casas a:hover {
    text-decoration: underline;
  }

  .ventanita {
    width: 2.75rem;
    height: auto;
  }

  .ventanita path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .ventanita.redonda path {
    stroke-width: 8;
  }

  .volver {
    margin-block-start: var(--space-2xl);
  }
</style>
