---
/**
 * 404: te perdiste en el monte. En el lenguaje editorial del sitio: el título enorme, una línea,
 * y las salidas como un índice de filas entre reglas finas (cada casa en su color). Al pasar el
 * mouse, la fila se llena con su color, como los links de la nav. Al final, volver al inicio.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Franja from '../components/Franja.astro';
import { ruta } from '../lib/rutas';

const cabanas = (await getCollection('cabanas')).sort((a, b) => a.data.orden - b.data.orden);

const salidas = [
  ...cabanas.map((c) => ({
    nombre: c.data.nombre,
    bajada: c.data.significado,
    href: ruta(`/cabanas/${c.id}/`),
    tema: c.data.tema,
  })),
  { nombre: 'Galería', bajada: 'El parque y la pileta', href: ruta('/galeria/'), tema: undefined },
  { nombre: 'Ubicación y contacto', bajada: 'Cómo llegar', href: ruta('/ubicacion-y-contacto/'), tema: undefined },
];
---

<Base
  title="Te perdiste en el monte · Misky Wayra"
  description="Esta página no existe. Volvé al inicio o seguí hacia una de las dos cabañas."
  noindex
>
  <Franja />

  <section class="perdido">
    <p class="antetitulo" data-revelar>Error 404</p>
    <h1 data-revelar style="--retraso: 0.08s">Te perdiste en el monte</h1>
    <p class="bajada" data-revelar style="--retraso: 0.16s">
      Esta página no existe, o se la llevó el viento. Seguí por acá:
    </p>

    <ul class="salidas">
      {
        salidas.map((s, i) => (
          <li data-revelar style={`--retraso: ${(0.2 + i * 0.08).toFixed(2)}s`}>
            <a href={s.href} data-theme={s.tema}>
              <span class="nombre">{s.nombre}</span>
              <span class="detalle">{s.bajada}</span>
              <span class="flecha" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a class="boton" href={ruta('/')} data-revelar="detalle" style="--retraso: 0.5s">Volver al inicio</a>
  </section>
</Base>

<script>
  import '../scripts/revelar';
</script>

<style>
  .perdido {
    --linea: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);

    display: grid;
    justify-items: start;
    padding-block: var(--space-3xl);
    text-align: start;
  }

  .perdido :global(p) {
    margin-inline: 0;
  }

  .antetitulo {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  h1 {
    max-width: 9em;
    margin-block-start: var(--space-s);
    font-size: clamp(3.4rem, 1.6rem + 7vw, 8.5rem);
    line-height: 0.92;
    color: var(--color-text);
  }

  .bajada {
    margin-block-start: var(--space-l);
  }

  /* ---------- Las salidas: un índice entre reglas finas ---------- */
  .salidas {
    width: 100%;
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
    border-block-start: var(--linea);
  }

  .salidas li {
    margin: 0;
    border-block-end: var(--linea);
  }

  .salidas a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-3xs) var(--space-m);
    padding: var(--space-m) var(--space-s);
    color: var(--color-text);
    text-decoration: none;
    transition:
      background-color 0.6s ease,
      color 0.6s ease;
  }

  .nombre {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.2rem + 2vw, 3rem);
    line-height: 1.05;
    color: var(--color-primary);
    transition: color 0.6s ease;
  }

  .detalle {
    grid-row: 2;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .flecha {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    font-size: var(--step-2);
  }

  @media (width >= 48rem) {
    .salidas a {
      grid-template-columns: minmax(0, 1fr) minmax(0, 16rem) auto;
      padding-block: var(--space-l);
    }

    .detalle {
      grid-row: auto;
    }

    .flecha {
      grid-column: auto;
      grid-row: auto;
    }
  }

  /* Al pasar, la fila se llena con su color (como los links de la nav) */
  .salidas a:hover,
  .salidas a:focus-visible {
    background: var(--color-primary);
    color: var(--color-on-color);
  }

  .salidas a:hover .nombre,
  .salidas a:focus-visible .nombre {
    color: var(--color-on-color);
  }

  /* ---------- Volver: el botón recto ---------- */
  .boton {
    margin-block-start: var(--space-2xl);
    padding: 1.1rem 2rem;
    background: var(--color-primary);
    color: var(--color-on-color);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.6s ease;
  }

  .boton:hover,
  .boton:focus-visible {
    background: var(--color-deep);
  }

  @media (width < 40rem) {
    .boton {
      width: 100%;
      text-align: center;
    }
  }
</style>
