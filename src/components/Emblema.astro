---
interface Props {
  variante?: 'completo' | 'compacto';
}

const { variante = 'completo' } = Astro.props;
const completo = variante === 'completo';

// IDs únicos por instancia: el emblema puede aparecer más de una vez por página
const id = `em-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="emblema" viewBox="94 118 312 222" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-cupula`} x1="195" y1="124" x2="267" y2="227" gradientUnits="userSpaceOnUse">
      <stop stop-color="#E06D43" />
      <stop offset="1" stop-color="#9C3A1A" />
    </linearGradient>
    <linearGradient id={`${id}-cuerpo`} x1="98" y1="175" x2="212" y2="411" gradientUnits="userSpaceOnUse">
      <stop stop-color="#E06D43" />
      <stop offset="1" stop-color="#9C3A1A" />
    </linearGradient>
    <linearGradient id={`${id}-ventanal`} x1="190" y1="220" x2="190" y2="320" gradientUnits="userSpaceOnUse">
      <stop stop-color="#4D574A" />
      <stop offset="1" stop-color="#33403B" />
    </linearGradient>
  </defs>

  <!-- Cúpula y su borde -->
  <path fill={`url(#${id}-cupula)`} d="M195 193C197 175 199 161 212 147C225 131 241 123 254 124C272 125 286 137 295 152C303 164 304 180 305 193C279 203 224 204 195 193Z" />
  <path fill="#AB4929" d="M199 184C227 190 266 192 301 184C298 190 279 196 251 196C226 195 209 191 199 184Z" />

  <!-- Cuerpo de adobe -->
  <path fill={`url(#${id}-cuerpo)`} d="M98.8 282.6C103.8 259.6 111.8 236.6 129.8 217.6C150.8 193.6 177.8 182.6 209.8 177.6C237.8 172.6 258.8 175.6 285.8 180.6C320.8 186.6 346.8 202.6 367.8 226.6C382.8 244.6 393.8 265.6 399.8 283.6C404.8 303.6 375.8 314.6 341.8 317.6C304.8 322.6 276.8 318.6 247.8 319.6C208.8 321.6 168.8 320.6 136.8 314.6C113.8 310.6 93.8 301.6 98.8 282.6Z" />

  <!-- Ventanal con sus parantes (el del medio es el eje) -->
  <path fill={`url(#${id}-ventanal)`} d="M190 320V235C190 215 310 215 310 235V320H190Z" />
  <path stroke="#DACCB1" stroke-width="3" stroke-linecap="round" d="M250 215V320" />
  <path stroke="#DACCB1" stroke-width="2" stroke-linecap="round" d="M190 270H310M220 223V320M280 223V320" />

  <!-- Suelo -->
  <path fill="#91856C" d="M103 320C137 310 164 315 190 318C222 322 277 324 309 319C343 315 371 312 397 320C385 329 363 331 334 332C287 337 223 334 184 332C147 332 122 332 103 320Z" />

  <!-- Ventanitas de la cúpula -->
  <path fill="#414D42" stroke="#F0C493" stroke-width="2" stroke-linejoin="round" d="M216 185V167C216 155 230 155 230 167V185C225 187 220 187 216 185ZM243 175V157C243 145 257 145 257 157V175C252 177 247 177 243 175ZM270 185V167C270 155 284 155 284 167V185C279 187 274 187 270 185Z" />

  {completo && (
    <>
      <path stroke="#C7BFA4" d="M221 168V180M248 158V170M275 168V180" />
      <!-- Plantas -->
      <path fill="#78805A" d="M121.2 319C110.2 314 108.2 304 109.2 296C118.2 297 123.2 306 121.2 319ZM122.2 314C122.2 301 128.2 293 137.2 292C138.2 303 132.2 313 122.2 314ZM378.2 322C368.2 318 365.2 310 366.2 303C374.2 304 379.2 312 378.2 322ZM379.2 317C380.2 306 385.2 299 393.2 298C393.2 308 387.2 316 379.2 317Z" />
    </>
  )}
</svg>

<style>
  .emblema {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
