---
/**
 * La nav de todo el sitio: una franja fina a todo el ancho, justo debajo de la foto
 * principal (o arriba de todo, en las páginas sin hero). Mientras bajás es parte de la página (sin fondo, sin
 * borde) y se va con ella; no reaparece mientras seguís bajando. Cuando subís, aparece fija
 * arriba, con las mismas medidas, difuminada (scripts/franja.ts). Al volver a su lugar,
 * vuelve a ser parte de la página.
 *
 * Celular: una sola nav (sin la barra del pulgar). "Menú" a la izquierda, el emblema en el
 * centro y "Consultar" (WhatsApp) a la derecha; el menú abre un panel con todos los links
 * (popover nativo: se cierra con la cruz, tocando afuera o con Esc, sin JavaScript).
 */
import Emblema from './Emblema.astro';
import { ruta } from '../lib/rutas';
import { whatsappUrl } from '../config';

const aqui = Astro.url.pathname;
const actual = (href: string) => (aqui === href ? 'page' : undefined);

const links = [
  { href: ruta('/cabanas/sumac-mayu/'), texto: 'Sumac Mayu', tema: 'mayu' },
  { href: ruta('/cabanas/misky-wayra/'), texto: 'Misky Wayra', tema: 'wayra' },
  { href: ruta('/galeria/'), texto: 'Galería' },
  { href: ruta('/ubicacion-y-contacto/'), texto: 'Ubicación y contacto' },
];
// En la página de una cabaña, "Consultar" ya pregunta por esa casa
const casa = links.slice(0, 2).find((l) => aqui === l.href)?.texto;
const whatsapp = whatsappUrl(`¡Hola! Quería consultar disponibilidad en ${casa ?? 'las cabañas'}`);
---

<div class="franja-nav">
  <nav class="barra" aria-label="Principal">
    <button class="solo-celular abrir" type="button" popovertarget="menu-franja">Menú</button>
    <div class="lado">
      <a href={ruta('/cabanas/sumac-mayu/')} data-theme="mayu" aria-current={actual(ruta('/cabanas/sumac-mayu/'))}>Sumac Mayu</a>
      <a href={ruta('/cabanas/misky-wayra/')} data-theme="wayra" aria-current={actual(ruta('/cabanas/misky-wayra/'))}>Misky Wayra</a>
    </div>
    <a class="marca" href={ruta('/')} aria-label="Misky Wayra, inicio">
      <Emblema variante="compacto" />
    </a>
    <div class="lado derecha">
      <a href={ruta('/galeria/')} aria-current={actual(ruta('/galeria/'))}>Galería</a>
      <a href={ruta('/ubicacion-y-contacto/')} aria-current={actual(ruta('/ubicacion-y-contacto/'))}>
        Ubicación y contacto
      </a>
    </div>
    <a class="solo-celular consultar" href={whatsapp}>Consultar</a>
  </nav>

  <!-- El menú del celular: todos los links, grandes, en un panel a pantalla completa -->
  <div id="menu-franja" class="menu" popover>
    <button class="cerrar" type="button" popovertarget="menu-franja" popovertargetaction="hide" aria-label="Cerrar el menú">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} data-theme={link.tema} aria-current={actual(link.href)}>
              {link.texto}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="menu-consultar" href={whatsapp}>Consultar por WhatsApp</a>
  </div>
</div>

<script>
  import '../scripts/franja';
</script>

<style>
  /* La envoltura guarda el lugar de la franja en la página cuando la barra pasa a fija */
  .franja-nav {
    --alto: 2.6rem;

    position: relative;
    z-index: 20;
    height: var(--alto);
  }

  .barra {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-m);
    height: var(--alto);
    padding-inline: clamp(1rem, 3vw, 2.5rem);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lado {
    display: flex;
    align-self: stretch; /* los links ocupan todo el alto de la franja */
    gap: clamp(0.5rem, 2vw, 1.5rem);
  }

  .lado.derecha {
    justify-content: flex-end;
  }

  .barra a {
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .barra a[aria-current='page'] {
    color: var(--color-primary);
  }

  /* Hover: el color de cada link aparece despacio como bloque de todo el alto de la franja.
     Cada cabaña en su color (data-theme); Galería y Ubicación en el oliva del complejo. */
  .lado a {
    display: flex;
    align-items: center;
    padding-inline: 0.9rem;
    transition:
      background-color 0.6s ease,
      color 0.6s ease;
  }

  .lado a:hover,
  .lado a:focus-visible {
    background: var(--color-primary);
    color: var(--color-on-color);
  }

  /* El emblema: más grande que al principio, pero sin tocar los bordes de la franja */
  .marca {
    display: block;
    width: 3.2rem; /* dentro de la franja, sin tocar los bordes */
  }

  /* ---------- Fija arriba, al subir ----------
     Difuminada: crema translúcido con blur. Entra bajando y apareciendo; se va igual. */
  .barra:global(.flotante) {
    position: fixed;
    inset: 0 0 auto;
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.15);
    box-shadow: 0 8px 24px -18px rgb(43 33 25 / 0.5);
    opacity: 0;
    translate: 0 -100%;
    transition:
      opacity 0.35s ease-out,
      translate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .barra:global(.flotante.visible) {
    opacity: 1;
    translate: 0 0;
  }

  /* Al pasar de la página a fija (fuera de la vista), sin animación: no tiene que verse */
  .barra:global(.sin-transicion) {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .barra:global(.flotante) {
      transition: opacity 0.2s;
      translate: 0 0;
    }
  }

  /* ---------- Celular: Menú · emblema · Consultar ---------- */
  .solo-celular,
  .menu:not(:popover-open) {
    display: none;
  }

  @media (width < 40rem) {
    .lado {
      display: none;
    }

    .barra {
      grid-template-columns: 1fr auto 1fr;
      padding-inline: var(--gutter);
    }

    .solo-celular {
      display: block;
      padding: 0;
      border: 0;
      background: none;
      color: var(--color-text);
      font: inherit;
      letter-spacing: inherit;
      text-transform: inherit;
      text-decoration: none;
      cursor: pointer;
    }

    .abrir {
      justify-self: start;
    }

    .consultar {
      justify-self: end;
      color: var(--color-primary);
    }

    /* El panel del menú: cubre la pantalla, cream, los links grandes en la serif */
    .menu:popover-open {
      position: fixed;
      inset: 0;
      width: auto;
      height: auto;
      margin: 0;
      padding: 5rem var(--gutter) var(--space-xl);
      border: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: var(--color-bg);
      color: var(--color-text);
    }

    .menu ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .menu li a {
      display: block;
      padding-block: var(--space-m);
      border-block-end: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      line-height: 1.2;
      color: var(--color-text);
      text-decoration: none;
    }

    .menu li a[data-theme],
    .menu li a[aria-current='page'] {
      color: var(--color-primary);
    }

    .menu-consultar {
      display: block;
      padding: var(--space-s);
      background: var(--color-primary);
      color: var(--color-on-color);
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-align: center;
      text-transform: uppercase;
      text-decoration: none;
    }

    .cerrar {
      position: absolute;
      top: var(--space-s);
      right: var(--gutter);
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      border: 1px solid color-mix(in srgb, var(--color-text) 30%, transparent);
      background: none;
      color: var(--color-text);
    }

    .cerrar svg {
      width: 1.1rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu:popover-open {
      animation: menu-entra 0.35s ease-out;
    }

    @keyframes menu-entra {
      from { opacity: 0; }
    }
  }
</style>
