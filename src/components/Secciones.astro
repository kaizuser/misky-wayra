---
/**
 * El relato del inicio: después del hero, el texto principal,
 * y una sección por parada que se cuenta con fotos, no con texto. Cada parada tiene su
 * composición (trío, cinco, fila, cruz, escalones, panorámica, par) y su propia forma de llegar al bajar.
 * El título de cada sección queda para lectores de pantalla y buscadores.
 *
 * Las composiciones se construyen de a una; mientras tanto, las que faltan se ven como
 * rectángulos grises con la cantidad de fotos de su composición.
 */
import Ampliable from './Ampliable.astro';
import type { ImageMetadata } from 'astro';

interface Foto {
  src: ImageMetadata;
  alt: string;
  encuadre: string;
}

interface Props {
  principal?: { frase: string; texto: string };
  paradas: {
    titulo: string;
    disposicion?: string;
    titular?: string;
    nota?: { titulo: string; subtitulo: string; estilo: 'centrada' | 'final' };
    fotos: Foto[];
  }[];
}

const { principal, paradas } = Astro.props;

/** Cuántas fotos lleva cada composición */
const cuantas: Record<string, number> = { trio: 3, cinco: 5, fila: 3, cruz: 4, escalones: 6, panoramica: 3, par: 2 };

/** El título expresivo en pedazos: palabras si hay varias; si es una, en tres partes ("Ad·en·tro") */
function pedazos(titulo: string) {
  const palabras = titulo.split(' ');
  if (palabras.length > 1) return palabras;
  const largo = Math.floor(titulo.length / 3); // el último se lleva lo que sobra: Ad·en·tro
  return [titulo.slice(0, largo), titulo.slice(largo, largo * 2), titulo.slice(largo * 2)].filter(Boolean);
}

/** Las posiciones del trío, de izquierda a derecha */
const lugaresTrio = ['izquierda', 'centro', 'derecha'];
---

{
  principal && (
    <section class="principal">
      <p class="frase" data-revelar>{principal.frase}</p>
      <p class="texto" data-revelar>{principal.texto}</p>
    </section>
  )
}

{
  // Solo las paradas con composición (las demás todavía no se muestran)
  paradas.filter((parada) => parada.disposicion).map((parada) => (
    <section class="seccion" data-disposicion={parada.disposicion} data-carrusel>
      <h2 class="solo-lectores">{parada.titulo}</h2>
      {parada.titular && (
        // La palabra como forma: entra de a un pedazo, como el texto principal
        <p class:list={['titular', parada.titular]} aria-hidden="true">
          {pedazos(parada.titulo).map((pedazo, i) => (
            <span data-revelar style={`--i: ${i}; --retraso: ${(i * 0.12).toFixed(2)}s`}>
              {pedazo}
            </span>
          ))}
        </p>
      )}
      {parada.disposicion === 'trio' ? (
        // Trío: tres fotos superpuestas que se abren hacia afuera y hacia arriba al bajar
        <div class="trio" data-galeria data-pista>
          {lugaresTrio.map((lugar, i) => {
            const foto = parada.fotos[i];
            return (
              <figure class:list={['foto', lugar, { pendiente: !foto }]} style={foto && `--encuadre: ${foto.encuadre}`}>
                <Ampliable foto={foto} widths={[400, 700, 1000]} sizes="(min-width: 40rem) 28vw, 38vw" />
              </figure>
            );
          })}
        </div>
      ) : parada.disposicion === 'cinco' ? (
        // Cinco: tres arriba y dos abajo, centradas en los huecos; cada una entra disparada
        <div class="cinco" data-galeria data-pista>
          {Array.from({ length: 5 }, (_, i) => {
            const foto = parada.fotos[i];
            const retraso = (i < 3 ? i * 0.08 : 0.12 + (i - 3) * 0.08).toFixed(2);
            return (
              <figure
                class:list={['foto', { pendiente: !foto }]}
                data-revelar
                style={`--retraso: ${retraso}s${foto ? `; --encuadre: ${foto.encuadre}` : ''}`}
              >
                <Ampliable foto={foto} widths={[400, 700, 1000]} sizes="(min-width: 40rem) 26vw, 45vw" />
              </figure>
            );
          })}
        </div>
      ) : parada.disposicion === 'cruz' ? (
        // Cruz: una vertical a cada lado y dos apiladas en el centro, que sobresalen arriba y
        // abajo. Cada foto entra disparada cuando le llega su turno al bajar.
        <div class="cruz" data-galeria data-pista>
          {[
            { lugar: 'izquierda', i: 0, retraso: 0 },
            { lugar: 'centro-arriba', i: 1, retraso: 0 },
            { lugar: 'centro-abajo', i: 2, retraso: 0 },
            { lugar: 'derecha', i: 3, retraso: 0.1 },
          ].map(({ lugar, i, retraso }) => {
            const foto = parada.fotos[i];
            return (
              <figure
                class:list={['foto', lugar, { pendiente: !foto }]}
                data-revelar
                style={`--retraso: ${retraso}s${foto ? `; --encuadre: ${foto.encuadre}` : ''}`}
              >
                <Ampliable foto={foto} widths={[400, 700, 1000]} sizes="(min-width: 40rem) 26vw, 45vw" />
              </figure>
            );
          })}
        </div>
      ) : parada.disposicion === 'escalones' ? (
        // Escalones: dos escaleras paralelas, pegadas, que bajan de derecha a izquierda por el
        // centro. Cada escalón tiene dos fotos lado a lado (una de cada escalera).
        <div class="escalones" data-galeria data-pista>
          {[0, 1, 2].map((escalon) => (
            <div class="escalon" style={`--i: ${escalon}`}>
              {[0, 1].map((escalera) => {
                const foto = parada.fotos[escalon * 2 + escalera];
                return (
                  <figure
                    class:list={['foto', { pendiente: !foto }]}
                    data-revelar
                    style={`--retraso: ${escalera * 0.1}s${foto ? `; --encuadre: ${foto.encuadre}` : ''}`}
                  >
                    <Ampliable foto={foto} widths={[400, 700, 1000]} sizes="(min-width: 40rem) 22vw, 45vw" />
                  </figure>
                );
              })}
            </div>
          ))}
        </div>
      ) : (
        <div class="composicion">
          {Array.from({ length: cuantas[parada.disposicion ?? 'fila'] ?? 3 }, () => (
            <div class="foto pendiente" />
          ))}
        </div>
      )}
      {parada.disposicion && cuantas[parada.disposicion] && (
        // En el celular, la composición es un carrusel: contador y flechas, como en las cabañas
        <div class="controles">
          <p class="contador" aria-live="polite">
            <span data-actual>1</span> / {cuantas[parada.disposicion]}
          </p>
          <button type="button" class="flecha" data-anterior aria-label={`Foto anterior de ${parada.titulo}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button type="button" class="flecha" data-siguiente aria-label={`Foto siguiente de ${parada.titulo}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      )}
      {parada.nota && (
        // Texto corto debajo de las fotos: entra como el texto principal
        <div class:list={['nota', parada.nota.estilo]}>
          <p class="nota-titulo" data-revelar>{parada.nota.titulo}</p>
          <p class="nota-subtitulo" data-revelar>{parada.nota.subtitulo}</p>
        </div>
      )}
    </section>
  ))
}

<script>
  import '../scripts/revelar';
  import '../scripts/lightbox';
  import '../scripts/carrusel';
</script>

<style>
  /* ---------- El texto principal ---------- */
  .principal {
    display: grid;
    justify-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-3xl);
  }

  .frase {
    max-width: 15em;
    margin: 0;
    font-family: var(--font-principal);
    font-size: clamp(2.6rem, 1.2rem + 5.4vw, 6.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--color-primary);
  }

  .texto {
    max-width: 40ch;
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-text) 85%, transparent);
  }

  /* La entrada se dispara al aparecer en pantalla (data-revelar, scripts/revelar.ts):
     primero la frase y un instante después el texto. Se repite cada vez que se vuelve a pasar. */
  .texto { --retraso: 0.15s; }

  /* ---------- Titulares expresivos ----------
     Escalera: la palabra en pedazos, cada uno un escalón más abajo y a la derecha, todo
     inclinado. Cada pedazo entra disparado (data-revelar), uno tras otro. */
  .titular {
    margin: 0 auto var(--space-2xl);
    font-family: var(--font-principal);
    font-weight: 400;
    line-height: 0.82;
    color: var(--color-primary);
    user-select: none;
  }

  /* Como renglones de un texto girado: cada pedazo sube hacia la derecha y el siguiente
     baja en diagonal; un escalonado leve los separa un poco más */
  .escalera {
    display: grid;
    justify-content: center;
    font-size: clamp(4rem, 1.5rem + 11vw, 13rem);
    line-height: 0.7;
    rotate: -32deg;
    translate: -0.25em 0; /* el escalonado lo corre a la derecha: lo devuelve al centro */
  }

  /* Pegado a la composición que presenta */
  .seccion:has(.cinco) .titular {
    margin-block-end: var(--space-l);
  }

  .escalera span {
    display: block;
    margin-inline-start: calc(var(--i) * 0.4em);
  }

  /* ---------- Trío: superpuestas, se abren al bajar ----------
     Composición final (como la referencia): la del medio más alta, la derecha más baja,
     cada una tapa un poco a la de su izquierda. Al bajar, las de los costados se abren
     hacia afuera y las tres suben; siguen superpuestas al final. Progresivo y reversible. */
  .trio {
    --ancho: 34.8%;   /* ancho de cada foto, del ancho de la composición */
    --pisada: -2.2%;  /* cuánto se pisan al final */

    display: flex;
    justify-content: center;
    align-items: flex-start;
    /* Como en la referencia: las tres juntas ocupan el 80% del ancho de la pantalla,
       más allá del ancho del contenido */
    width: 80vw;
    margin-inline: calc((100% - 80vw) / 2);
    view-timeline-name: --trio; /* las tres avanzan juntas, con la composición */
  }

  .trio .foto {
    flex: none;
    width: var(--ancho);
    aspect-ratio: 2 / 3;
    margin: 0;
    overflow: hidden;
  }

  .trio .izquierda { margin-top: 11%; margin-inline-end: var(--pisada); z-index: 1; }
  .trio .centro { z-index: 2; }
  .trio .derecha { margin-top: 20%; margin-inline-start: var(--pisada); z-index: 3; }

  .trio :global(picture),
  .trio :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .trio :global(img) {
    object-fit: cover;
    object-position: var(--encuadre, 50% 50%);
  }

  /* Tres tonos, para que se lea la superposición mientras no hay fotos */
  .trio .izquierda.pendiente { background: color-mix(in srgb, var(--color-text) 13%, var(--color-bg)); }
  .trio .centro.pendiente { background: color-mix(in srgb, var(--color-text) 21%, var(--color-bg)); }
  .trio .derecha.pendiente { background: color-mix(in srgb, var(--color-text) 29%, var(--color-bg)); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Propiedades sueltas, no el atajo "animation: linear both" sin nombre: el minificador
         lo convierte en "animation: none" y se pierde el "both" (el estado inicial) */
      .trio .foto {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --trio;
        animation-range: cover 10% cover 55%;
      }

      .trio .izquierda { animation-name: trio-izquierda; }
      .trio .centro { animation-name: trio-centro; }
      .trio .derecha { animation-name: trio-derecha; }

      /* Arrancan un poco más juntas (hacia el centro) y más abajo: con fotos grandes,
         un movimiento chico alcanza */
      @keyframes trio-izquierda { from { translate: 10% 6%; } }
      @keyframes trio-centro { from { translate: 0 4.5%; } }
      @keyframes trio-derecha { from { translate: -10% 6%; } }
    }
  }

  /* Mobile: la misma composición, con fotos más anchas y más pisadas para que se lean */


  /* ---------- Nota: título y subtítulo centrados, debajo de las fotos ----------
     Como el texto principal, pero más chica y con menos texto. Después, más aire
     antes de la sección siguiente. */
  .nota {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-3xl);
    text-align: center;
  }

  .nota-titulo {
    max-width: 16em;
    margin: 0;
    font-family: var(--font-principal);
    font-size: clamp(2.2rem, 1rem + 3.6vw, 4.25rem);
    line-height: 1.02;
    text-wrap: balance;
    color: var(--color-primary);
  }

  .nota-subtitulo {
    --retraso: 0.15s;

    max-width: 46ch;
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-text) 85%, transparent);
  }

  .seccion:has(.nota) {
    padding-block-end: calc(var(--space-3xl) * 2);
  }

  /* Final: como el cierre de la referencia. Alineada a la izquierda, casi al borde;
     título muy grande en dos renglones y un párrafo ancho de cuatro */
  .nota.final {
    justify-items: start;
    gap: 3.5rem;
    margin-block-start: calc(var(--space-3xl) * 2); /* bien separada de las fotos de arriba */
    /* Casi al borde izquierdo de la pantalla, más allá del margen del contenido */
    margin-inline-start: calc((100% - 100vw) / 2 + 4vw);
    text-align: start;
  }

  .final .nota-titulo {
    max-width: 7.5em;
    font-size: clamp(3rem, 1.4rem + 5.2vw, 6.25rem);
    line-height: 0.92;
    text-wrap: initial;
  }

  .final .nota-subtitulo {
    max-width: 40rem;
    line-height: 1.55;
  }

  @media (width < 40rem) {
    .nota.final {
      margin-inline-start: 0;
      gap: var(--space-l);
    }
  }

  /* ---------- Cinco: tres arriba, dos abajo centradas en los huecos ----------
     Misma escala que el trío (80% del ancho). Cada foto entra disparada desde abajo
     (data-revelar), apenas escalonadas; las de abajo, un poco después. */
  .cinco {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-s);
    width: 80vw;
    margin-inline: calc((100% - 80vw) / 2);
  }

  .cinco .foto {
    grid-column: span 2;
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
  }

  .cinco .foto:nth-child(4) { grid-column: 2 / span 2; }
  .cinco .foto:nth-child(5) { grid-column: 4 / span 2; }

  .cinco :global(picture),
  .cinco :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cinco :global(img) {
    object-fit: cover;
    object-position: var(--encuadre, 50% 50%);
  }

  .cinco .pendiente {
    background: color-mix(in srgb, var(--color-text) 16%, var(--color-bg));
  }

  /* ---------- Cruz: verticales a los costados, dos apiladas en el centro ----------
     Medida sobre la referencia: 80% del ancho, tres columnas iguales; la del centro es más
     alta y sobresale arriba y abajo, los costados quedan centrados respecto de ella. */
  .cruz {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto;
    column-gap: 2.2%;
    row-gap: var(--space-l);
    align-items: center;
    width: 80vw;
    margin-inline: calc((100% - 80vw) / 2);
  }

  .cruz .foto {
    margin: 0;
    overflow: hidden;
  }

  .cruz .izquierda,
  .cruz .derecha {
    grid-row: 1 / span 2;
    aspect-ratio: 3 / 4;
  }

  .cruz .izquierda { grid-column: 1; }
  .cruz .derecha { grid-column: 3; }

  .cruz .centro-arriba,
  .cruz .centro-abajo {
    grid-column: 2;
    aspect-ratio: 5 / 6;
  }

  .cruz .centro-arriba { grid-row: 1; }
  .cruz .centro-abajo { grid-row: 2; }

  .cruz :global(picture),
  .cruz :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cruz :global(img) {
    object-fit: cover;
    object-position: var(--encuadre, 50% 50%);
  }

  .cruz .pendiente {
    background: color-mix(in srgb, var(--color-text) 16%, var(--color-bg));
  }

  /* ---------- Escalones: dos escaleras paralelas que bajan de derecha a izquierda ----------
     Sobre el 80% del ancho: cada escalón es un par de fotos (22vw cada una, 4:5) con un
     espacio chico entre ellas; cada escalón se corre a la izquierda y baja, del borde
     derecho de la composición al izquierdo, así las dos escaleras pasan por el centro.
     Va de derecha a izquierda porque el texto anterior está pegado a la izquierda: zigzag. */
  .escalones {
    --foto: 22vw;   /* ancho de cada foto */
    --entre: 1.2vw; /* espacio entre las dos escaleras */
    --ancho: 80vw;  /* ancho de la composición */

    display: grid;
    row-gap: var(--space-m);
    width: var(--ancho);
    margin-inline: calc((100% - var(--ancho)) / 2);
  }

  /* Cada escalón: el par de fotos; los tres recorren el ancho de borde a borde */
  .escalon {
    display: flex;
    gap: var(--entre);
    width: calc(2 * var(--foto) + var(--entre));
    margin-inline-start: calc((2 - var(--i)) * (var(--ancho) - 2 * var(--foto) - var(--entre)) / 2);
  }

  .escalones .foto {
    flex: 1;
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
  }

  .escalones :global(picture),
  .escalones :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .escalones :global(img) {
    object-fit: cover;
    object-position: var(--encuadre, 50% 50%);
  }

  .escalones .pendiente {
    background: color-mix(in srgb, var(--color-text) 16%, var(--color-bg));
  }

  /* ---------- Las secciones de fotos (esqueleto provisorio) ---------- */
  .seccion {
    padding-block: var(--space-2xl);
    /* Lo que sobresale de costado (el titular girado, las fotos que llegan) no ensancha la
       página: un elemento rotado también cuenta para el ancho, y en el celular lo estiraba */
    overflow-x: clip;
  }

  .composicion {
    display: flex;
    justify-content: center;
    gap: var(--space-s);
  }

  .composicion .pendiente {
    flex: 1;
    max-width: 22rem;
    aspect-ratio: 3 / 4;
    background: color-mix(in srgb, var(--color-text) 14%, var(--color-bg));
  }

  /* Controles del carrusel: solo en el celular */
  .controles {
    display: none;
  }

  /* ---------- Mobile: cada composición es un carrusel ----------
     Una foto por ancho de pantalla, de a una al deslizar (scroll nativo con snap). Sin las
     posiciones ni los movimientos de desktop: las fotos llegan ya visibles al deslizarlas. */
  @media (width < 40rem) {
    .trio,
    .cinco,
    .cruz,
    .escalones {
      display: flex;
      justify-content: flex-start; /* el trío centra en desktop: acá cortaría la primera foto */
      gap: var(--space-s);
      /* De margen a margen: cada foto ocupa justo el ancho, sin que asome la siguiente */
      width: auto;
      margin-inline: 0;
      padding-inline: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }

    .trio::-webkit-scrollbar,
    .cinco::-webkit-scrollbar,
    .cruz::-webkit-scrollbar,
    .escalones::-webkit-scrollbar {
      display: none;
    }

    .escalon {
      display: contents;
    }

    .trio .foto,
    .cinco .foto,
    .cruz .foto,
    .escalones .foto {
      flex: none;
      width: 100%;
      aspect-ratio: 4 / 5;
      margin: 0;
      translate: none;
      animation: none;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    /* Las entradas disparadas no aplican adentro de un carrusel */
    :global(.revelar) .cinco .foto[data-revelar],
    :global(.revelar) .cruz .foto[data-revelar],
    :global(.revelar) .escalones .foto[data-revelar] {
      opacity: 1;
      translate: none;
      animation: none; /* las entradas ahora son animaciones (global.css): también se apagan */
    }

    /* Contador y flechas debajo del carrusel, alineados a la derecha (como en las cabañas) */
    .controles {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: var(--space-2xs);
      margin-block-start: var(--space-s);
    }

    .contador {
      margin: 0 var(--space-s) 0 0;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      font-variant-numeric: tabular-nums;
    }

    .flecha {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      border: 1px solid color-mix(in srgb, var(--color-text) 30%, transparent);
      background: transparent;
      color: var(--color-text);
    }

    .flecha:disabled {
      opacity: 0.3;
    }

    .flecha svg {
      width: 1.1rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
    }

    /* Espaciados parejos: cada bloque separado por lo mismo */
    .principal {
      padding-block: var(--space-3xl) var(--space-2xl);
      gap: var(--space-l);
    }

    .seccion,
    .seccion:has(.nota) {
      padding-block: var(--space-2xl);
    }

    .titular {
      margin-block-end: var(--space-xl);
    }

    .nota,
    .nota.final {
      margin-block-start: var(--space-2xl);
    }

