---
/**
 * La otra casa: al final de la página de cada cabaña, para pasar de una a
 * la otra. Una foto grande y rectangular de la casa hermana, a lo ancho del contenido, con su
 * nombre en la serif y un "Conocer" en mayúsculas chicas. Toda la pieza es el link.
 * Toma el tema (color) de la otra casa.
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ruta } from '../lib/rutas';

interface Props {
  id: string;
  nombre: string;
  significado: string;
  tema: 'mayu' | 'wayra';
  foto: { src: ImageMetadata; alt: string; encuadre: string; vertical?: ImageMetadata };
}

const { id, nombre, significado, tema, foto } = Astro.props;

// En el celular la caja es 4:5: con la foto horizontal se veía una franja agrandada (borrosa).
// Ahí va el recorte vertical del hero.
const vertical = foto.vertical
  ? await Promise.all(
      (['avif', 'webp'] as const).map(async (format) => ({
        type: `image/${format}`,
        srcset: (
          await Promise.all([480, 720, 960, 1200].map((width) => getImage({ src: foto.vertical!, width, format })))
        )
          .map((img) => `${img.src} ${img.attributes.width}w`)
          .join(', '),
      })),
    )
  : [];
---

<aside class="otra" data-theme={tema} aria-label="La otra casa">
  <a class="tarjeta" href={ruta(`/cabanas/${id}/`)}>
    <figure style={`--encuadre: ${foto.encuadre}`} data-revelar="foto">
      <Picture
        src={foto.src}
        alt={foto.alt}
        formats={['avif', 'webp']}
        widths={[800, 1400, 2000]}
        sizes="(min-width: 72rem) 72rem, 100vw"
        pictureAttributes={{ class: 'horizontal' }}
      />
      {
        // Astro no permite <source> con media en <Picture>: se suma la versión del celular adelante
        vertical.length > 0 && (
          <picture class="vertical">
            {vertical.map((v) => (
              <source type={v.type} srcset={v.srcset} sizes="calc(100vw - 2rem)" />
            ))}
            <img src={vertical[1].srcset.split(' ')[0]} alt={foto.alt} loading="lazy" decoding="async" />
          </picture>
        )
      }
    </figure>
    <div class="texto" data-revelar style="--retraso: 0.15s">
      <p class="antetitulo">La otra casa · {significado}</p>
      <p class="nombre">{nombre}</p>
      <span class="conocer">Conocer {nombre} →</span>
    </div>
  </a>
</aside>

<script>
  import '../scripts/revelar';
</script>

<style>
  .otra {
    padding-block: var(--space-xl) var(--space-3xl);
    text-align: start;
  }

  .tarjeta {
    display: grid;
    gap: var(--space-m);
    color: var(--color-text);
    text-decoration: none;
  }

  figure {
    margin: 0;
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }

  figure :global(picture),
  figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  figure :global(img) {
    object-fit: cover;
    object-position: var(--encuadre);
    transition: scale 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tarjeta:hover figure :global(img) {
    scale: 1.03;
  }

  .texto {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--space-2xs) var(--space-m);
  }

  .antetitulo {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nombre {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1.4rem + 4.4vw, 5.5rem);
    line-height: 0.95;
    color: var(--color-primary);
  }

  .conocer {
    padding-block-end: 0.6rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.6s ease;
  }

  .tarjeta:hover .conocer {
    color: var(--color-primary);
  }

  /* Una sola de las dos versiones a la vez (son lazy: la que no se ve no se descarga) */
  figure :global(.vertical) {
    display: none;
  }

  @media (width < 40rem) {
    figure :global(.horizontal) {
      display: none;
    }

    figure :global(.vertical) {
      display: block;
    }
  }

  @media (width < 40rem) {
    figure {
      aspect-ratio: 4 / 5;
    }

    .texto {
      grid-template-columns: 1fr;
    }
  }
</style>
