---
/**
 * Navegación (versión funcional; el diseño propio llega con `nav-design`).
 *
 * - Desktop/tablet: barra con el emblema en el centro (la cúpula) y una cabaña
 *   en cada ala. Arriba de todo es transparente; al scrollear se condensa en
 *   una barra flotante. Las secciones de información quedan fuera del eje.
 * - Mobile: arriba solo el emblema; abajo, barra para el pulgar con las dos
 *   cabañas y WhatsApp en el centro.
 */
import Emblema from './Emblema.astro';
import { whatsappUrl } from '../config';
import { ruta } from '../lib/rutas';

const aqui = Astro.url.pathname; // con la base y siempre con barra final (trailingSlash: 'always')
const actual = (href: string) => (aqui === href ? 'page' : undefined);

const whatsapp = whatsappUrl('Hola! Quería consultar disponibilidad en Misky Wayra');
---

<header class="cabecera">
  <nav class="eje" aria-label="Cabañas">
    <a class="ala" href={ruta('/cabanas/sumac-mayu/')} data-theme="mayu" aria-current={actual(ruta('/cabanas/sumac-mayu/'))}>
      Sumac Mayu
    </a>
    <a class="cupula" href={ruta('/')} aria-label="Misky Wayra, inicio" aria-current={actual(ruta('/'))}>
      <Emblema />
    </a>
    <a class="ala" href={ruta('/cabanas/misky-wayra/')} data-theme="wayra" aria-current={actual(ruta('/cabanas/misky-wayra/'))}>
      Misky Wayra
    </a>
  </nav>

  <!-- Fuera del eje. En desktop se ve como links; en pantallas chicas, como menú -->
  <button class="abrir-menu" popovertarget="utilidades" aria-label="Más secciones">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </button>
  <nav id="utilidades" class="utilidades" popover aria-label="Información">
    <ul>
      <li><a href={ruta('/galeria/')} aria-current={actual(ruta('/galeria/'))}>Galería</a></li>
      <li><a href={ruta('/ubicacion-y-contacto/')} aria-current={actual(ruta('/ubicacion-y-contacto/'))}>Ubicación y contacto</a></li>
    </ul>
  </nav>
</header>

<nav class="pulgar" aria-label="Accesos rápidos">
  <a class="ala" href={ruta('/cabanas/sumac-mayu/')} data-theme="mayu" aria-current={actual(ruta('/cabanas/sumac-mayu/'))}>
    Sumac Mayu
  </a>
  <a class="consultar" href={whatsapp} aria-label="Consultar por WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 18.5V7a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H9z" />
    </svg>
  </a>
  <a class="ala" href={ruta('/cabanas/misky-wayra/')} data-theme="wayra" aria-current={actual(ruta('/cabanas/misky-wayra/'))}>
    Misky Wayra
  </a>
</nav>

<style>
  /* ---------- Cabecera ---------- */
  .cabecera {
    view-transition-name: cabecera; /* queda quieta al cambiar de página */
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    padding: var(--space-m) var(--gutter);
    pointer-events: none; /* solo la barra y el menú reciben clics */
  }

  .cabecera > * {
    pointer-events: auto;
  }

  .eje {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-2xs) var(--space-l);
    border-radius: 999px;

    /* Estado condensado (flotante) */
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    box-shadow: 0 8px 24px -14px rgb(43 33 25 / 0.45);
    backdrop-filter: blur(8px);
  }

  .ala {
    font-family: var(--font-display);
    font-weight: var(--peso-titulo);
    font-size: var(--step-1);
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .eje .ala:first-child { justify-self: end; }   /* hacia el centro */
  .eje .ala:last-child { justify-self: start; }  /* hacia el centro */

  .ala:hover,
  .ala[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* La cúpula: el emblema sobresale de la barra */
  .cupula {
    display: block;
    width: 4.5rem;
    margin-block: -1rem;
  }

  /* Arriba de todo: abierta, sin fondo, emblema grande. Se condensa al scrollear. */
  @supports (animation-timeline: scroll()) {
    .eje {
      animation: abrir linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 10rem;
    }

    .cupula {
      animation: agrandar linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 10rem;
    }

    @keyframes abrir {
      from {
        background: transparent;
        box-shadow: none;
        backdrop-filter: none;
        padding-block: var(--space-s);
      }
    }

    @keyframes agrandar {
      from { transform: scale(1.45) translateY(12%); }
    }
  }

  /* ---------- Información: fuera del eje ---------- */
  .abrir-menu {
    display: none;
    position: absolute;
    right: var(--gutter);
    top: 50%;
    translate: 0 -50%;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: 0 6px 18px -12px rgb(43 33 25 / 0.5);
    cursor: pointer;
  }

  .abrir-menu svg {
    width: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .utilidades ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .utilidades a {
    color: var(--color-text);
  }

  /* Desktop: los links se ven siempre, chicos, al costado */
  @media (width >= 64rem) {
    .utilidades[popover] {
      display: block;
      position: absolute;
      inset: auto;
      right: var(--gutter);
      top: 50%;
      translate: 0 -50%;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      overflow: visible;
    }

    .utilidades ul {
      display: flex;
      gap: var(--space-m);
      font-size: var(--step--1);
    }
  }

  /* Pantallas chicas: botón que abre un menú */
  @media (width < 64rem) {
    .abrir-menu {
      display: grid;
    }

    .utilidades[popover]:popover-open {
      position: fixed;
      inset: auto;
      top: calc(var(--space-m) + 3.25rem);
      right: var(--gutter);
      margin: 0;
      padding: var(--space-m) var(--space-l);
      border: 0;
      border-radius: var(--radius);
      background: var(--color-bg);
      box-shadow: 0 12px 32px -16px rgb(43 33 25 / 0.5);
    }

    .utilidades li + li {
      margin-block-start: var(--space-xs);
    }
  }

  /* ---------- Barra del pulgar (solo mobile) ---------- */
  .pulgar {
    display: none;
  }

  @media (width < 40rem) {
    .eje {
      grid-template-columns: auto;
      padding-inline: var(--space-m);
    }

    .eje .ala {
      display: none; /* en mobile las cabañas están en la barra de abajo */
    }

    .cupula {
      width: 3.5rem;
    }

    .pulgar {
      view-transition-name: pulgar;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--space-s);
      position: fixed;
      inset-inline: var(--space-s);
      bottom: calc(var(--space-s) + env(safe-area-inset-bottom, 0px));
      z-index: 20;
      padding: var(--space-xs) var(--space-m);
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-bg) 92%, transparent);
      box-shadow: 0 8px 24px -14px rgb(43 33 25 / 0.5);
      backdrop-filter: blur(8px);
    }

    .pulgar .ala {
      font-size: var(--step-0);
    }

    .pulgar .ala:first-child { justify-self: end; }
    .pulgar .ala:last-child { justify-self: start; }

    /* WhatsApp en la cúpula de la barra */
    .consultar {
      display: grid;
      place-items: center;
      width: 3.5rem;
      height: 3.5rem;
      margin-block: -1.25rem;
      border-radius: 50%;
      background: var(--color-primary);
      color: var(--color-on-color);
      box-shadow: 0 6px 16px -8px rgb(43 33 25 / 0.6);
    }

    .consultar svg {
      width: 1.5rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linejoin: round;
    }

    /* Espacio para que la barra no tape el final de la página */
    :global(body) {
      padding-block-end: 6rem;
    }
  }
</style>
