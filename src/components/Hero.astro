---
/**
 * Hero del inicio: la historia. "Todo empezó en Misky Wayra."
 * Las dos casas son dos capítulos unidos por un camino sobre el eje:
 * I · Misky Wayra (la primera, a la derecha) en su ventana redonda;
 * II · Sumac Mayu (la que vino después, a la izquierda) en su arco.
 * Cada ventana lleva una línea fina alrededor, separada de la foto, en el color de su casa:
 * el mismo trazo de las volutas y del camino.
 * Cada foto comparte view-transition-name con el hero de su cabaña: al navegar, la ventana crece.
 */
import { Picture } from 'astro:assets';
import sumac from '../assets/home/hero-sumac.jpg';
import misky from '../assets/home/hero-misky.jpg';
import { whatsappUrl } from '../config';
import { ruta } from '../lib/rutas';
---

<section class="hero">
  <div class="relato">
    <p class="antetitulo">Cabañas de adobe en Capilla del Monte</p>
    <h1>Todo empezó en <em data-theme="wayra">Misky&nbsp;Wayra.</em></h1>
    <p class="bajada">
      Dos casas de adobe hechas a mano, en un parque frente al Uritorco. Una redonda, con techo
      verde. La otra, con cúpula y un ventanal en arco.
    </p>
  </div>

  <!-- I · La primera casa -->
  <a class="capitulo misky" href={ruta('/cabanas/misky-wayra/')} data-theme="wayra">
    <span class="ventana">
      <span class="foto">
        <Picture
          src={misky}
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600, 2048]}
          sizes="(min-width: 40rem) 27rem, 70vw"
          alt="Misky Wayra: casa redonda de techo verde con guarda de azulejos, bajo un algarrobo"
          loading="eager"
          fetchpriority="high"
        />
      </span>
    </span>
    <span class="rotulo">
      <span class="numero">I · La primera casa</span>
      <span class="nombre">Misky Wayra</span>
      <span class="significado">Viento dulce</span>
    </span>
  </a>

  <!-- En mobile, el camino baja en curva de una casa a la otra -->
  <svg class="curva" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path d="M78,0 C78,55 22,45 22,100" vector-effect="non-scaling-stroke"></path>
  </svg>

  <!-- II · La que vino después -->
  <a class="capitulo sumac" href={ruta('/cabanas/sumac-mayu/')} data-theme="mayu">
    <span class="ventana">
      <span class="foto">
        <Picture
          src={sumac}
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600, 2048]}
          sizes="(min-width: 40rem) 29rem, 70vw"
          alt="Fachada de Sumac Mayu: casa de adobe con cúpula, alero ondulado y un gran ventanal en arco"
          loading="eager"
        />
      </span>
    </span>
    <span class="rotulo">
      <span class="numero">II · La que vino después</span>
      <span class="nombre">Sumac Mayu</span>
      <span class="significado">Río hermoso</span>
    </span>
  </a>

  <div class="despues">
    <p class="sigue">
      Después, del otro lado del parque, se levantó <span data-theme="mayu">Sumac Mayu</span>.
    </p>
    <p>[Una frase de la familia sobre por qué la hicieron, o cómo.]</p>
    <a class="boton" href={whatsappUrl('Hola! Quería consultar disponibilidad en Misky Wayra')}>
      Consultá disponibilidad
    </a>
  </div>
</section>

<style>
  .hero {
    --camino: 1.5px dashed color-mix(in srgb, var(--color-text) 35%, transparent);
    --margen: 0.75rem; /* separación entre cada foto y su línea */

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    text-align: start;
  }

  .hero p {
    margin-inline: 0;
  }

  /* ---------- El relato ---------- */
  .relato {
    display: grid;
    gap: var(--space-m);
  }

  .antetitulo {
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  h1 {
    font-weight: 350;
    font-size: clamp(3rem, 1.8rem + 4.4vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
    color: var(--color-text);
  }

  h1 em {
    font-weight: 400;
    color: var(--color-primary);
  }

  .bajada {
    max-width: 30ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  /* ---------- Los capítulos: una casa por lado ---------- */
  .capitulo {
    display: grid;
    gap: calc(var(--space-s) + var(--margen)); /* medido desde la línea, no desde la foto */
    text-decoration: none;
    color: var(--color-primary);
  }

  .misky { justify-items: end; margin-block-start: var(--space-2xl); }
  .sumac { justify-items: start; }

  .ventana {
    position: relative;
    display: block;
  }

  /* La línea fina alrededor de cada ventana, con la misma forma */
  .ventana::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--margen));
    border: 1.5px solid var(--color-primary);
    pointer-events: none;
  }

  .foto {
    display: block;
    overflow: hidden;
  }

  .foto :global(picture),
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .foto :global(img) {
    object-fit: cover;
    transition: scale 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Misky: la ventana redonda */
  .misky .ventana {
    width: min(64vw, 25rem);
    aspect-ratio: 1;
  }

  .misky .ventana::before {
    border-radius: 50%;
  }

  .misky .foto {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    view-transition-name: casa-misky-wayra;
  }

  .misky .foto :global(img) { object-position: 46% 60%; }

  /* Sumac: el arco */
  .sumac .ventana {
    width: min(64vw, 27rem);
    margin-block-start: var(--space-l);
    margin-inline-start: var(--margen); /* la línea no toca el borde de la pantalla */
  }

  .sumac .ventana::before {
    border-radius: 50% 50% calc(0.375rem + var(--margen)) calc(0.375rem + var(--margen)) / 38% 38%
      calc(0.375rem + var(--margen)) calc(0.375rem + var(--margen));
  }

  .sumac .foto {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 50% 50% 0.375rem 0.375rem / 38% 38% 0.375rem 0.375rem;
    view-transition-name: casa-sumac-mayu;
  }

  .sumac .foto :global(img) { object-position: 42% 45%; }

  /* Rótulo de cada casa */
  .rotulo {
    display: grid;
    justify-items: inherit;
    gap: var(--space-3xs);
    padding-inline: var(--space-2xs);
  }

  .numero {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step--1);
  }

  .nombre {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-3);
    line-height: 1.1;
  }

  .significado {
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-deep);
  }

  /* Al pasar: la foto se acerca */
  .capitulo:hover .foto :global(img) { scale: 1.04; }

  /* También al pasar por su nombre en la navegación */
  :global(body:has(.eje [data-theme='wayra']:hover)) .misky .foto :global(img),
  :global(body:has(.eje [data-theme='mayu']:hover)) .sumac .foto :global(img) { scale: 1.04; }

  .capitulo:focus-visible {
    outline-offset: 6px;
  }

  /* ---------- El camino entre las dos (mobile) ---------- */
  .curva {
    width: 100%;
    height: 5rem;
    margin-block: var(--space-s);
    overflow: visible;
  }

  .curva path {
    fill: none;
    stroke: color-mix(in srgb, var(--color-text) 35%, transparent);
    stroke-width: 1.5;
    stroke-dasharray: 5 6;
  }

  /* ---------- Y después ---------- */
  .despues {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
    margin-block-start: var(--space-2xl);
  }

  .sigue {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--step-3);
    line-height: var(--leading-tight);
  }

  .sigue span { color: var(--color-primary); }

  .boton {
    margin-block-start: var(--space-xs);
    padding: var(--space-xs) var(--space-l);
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-on-color);
    text-decoration: none;
  }

  .boton:hover { background: var(--color-deep); }

  /* ---------- Tablet y desktop: dos columnas y el eje en el medio ---------- */
  @media (min-width: 40rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(2rem, 6vw, 6rem);
      align-items: center;
    }

    /* El camino: una línea punteada sobre el eje, de una casa a la otra */
    .hero::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 30%;
      bottom: 22%;
      border-left: var(--camino);
    }

    .curva { display: none; }

    .misky {
      justify-items: center;
      margin-block-start: 0;
    }

    .sumac {
      justify-items: center;
      margin-block-start: var(--space-2xl);
    }

    .misky .ventana { width: min(calc(100% - 2 * var(--margen)), 25rem); }
    .sumac .ventana { width: min(80%, 27rem); margin-inline-start: 0; }

    .despues { margin-block-start: var(--space-2xl); }
  }

  /* ---------- El camino se dibuja al bajar (como en el recorrido) ----------
     Se descubre con clip-path, no con scale, para que los puntos no se estiren. */
  @supports (animation-timeline: scroll()) {
    .hero::before {
      animation: dibujar linear both;
      animation-timeline: scroll(root);
      animation-range: 0 60vh;
    }

    .curva {
      animation: dibujar linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 55%;
    }

    @keyframes dibujar {
      from { clip-path: inset(0 0 100% 0); }
      to { clip-path: inset(0); }
    }
  }
</style>
