---
/**
 * Una foto que se abre en grande al tocarla (PhotoSwipe, scripts/lightbox.ts): el link lleva la
 * versión grande y sus medidas. Va dentro de un contenedor con [data-galeria], que agrupa las
 * fotos que se recorren juntas con las flechas.
 * Sin foto todavía, el link abre un gris del mismo tono, para probar el recorrido.
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// Los estilos del visor van con cada foto que se abre en grande (sin ellos, el visor queda
// invisible, sin la cruz, y tapa la página agarrando los clics)
import 'photoswipe/style.css';

interface Props {
  foto?: { src: ImageMetadata; alt: string; epigrafe?: string };
  widths: number[];
  sizes: string;
}

const { foto, widths, sizes } = Astro.props;

const grande = foto
  ? await getImage({ src: foto.src, width: Math.min(2048, foto.src.width), format: 'webp', quality: 82 })
  : null;

// El gris de muestra: 4:5, para ver cómo se abre y se recorre sin fotos
const muestra =
  'data:image/svg+xml,' +
  encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="1500"><rect width="100%" height="100%" fill="#d6ccbc"/></svg>');
---

{
  foto && grande ? (
    <a
      class="ampliar"
      href={grande.src}
      data-pswp-width={grande.attributes.width}
      data-pswp-height={grande.attributes.height}
      data-epigrafe={foto.epigrafe ?? foto.alt}
      aria-label={`Ver en grande: ${foto.alt}`}
    >
      <Picture src={foto.src} alt={foto.alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} />
    </a>
  ) : (
    <a
      class="ampliar"
      href={muestra}
      data-pswp-width="1200"
      data-pswp-height="1500"
      data-epigrafe="Foto en camino"
      aria-label="Ver en grande: foto en camino"
    />
  )
}
