---
/**
 * El pie, en todas las páginas: un cierre, no un menú. El emblema grande, el nombre, una línea
 * corta y las redes. Sin links a las páginas (eso ya está en la nav).
 */
import Emblema from './Emblema.astro';
import { SITIO } from '../config';
---

<footer class="pie" data-theme="tierra">
  <div class="fila">
    <div class="marca">
      <div class="emblema"><Emblema /></div>
      <div>
        <p class="nombre">Misky Wayra</p>
        <p class="linea">Dos casas de adobe frente al Uritorco. Te esperamos.</p>
      </div>
    </div>
    {
      SITIO.redes.length > 0 && (
        <ul class="redes" aria-label="Redes sociales">
          {SITIO.redes.map((red) => (
            <li>
              <a href={red.url} rel="noopener">
                {red.nombre}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <p class="firma">© {new Date().getFullYear()} · {SITIO.localidad}</p>
</footer>

<style>
  /* Compacto: el emblema a un costado con el nombre y la línea; las redes del otro lado */
  .pie {
    padding: var(--space-xl) max(var(--gutter), (100% - var(--axis-width)) / 2) var(--space-m);
    background: var(--arena);
    color: var(--tinta);
    text-align: start;
  }

  .fila {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-l);
  }

  .marca {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .emblema {
    flex: none;
    width: 5.5rem;
  }

  /* El nombre con la letra de la nav: sans, mayúsculas, espaciada */
  .nombre {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .linea {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
  }

  .redes {
    display: flex;
    gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .redes a {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta);
    text-decoration: none;
    border-block-end: 1px solid color-mix(in srgb, var(--tinta) 35%, transparent);
    padding-block-end: 0.2rem;
    transition: border-color 0.6s ease;
  }

  .redes a:hover {
    border-color: var(--tinta);
  }

  .firma {
    max-width: none;
    margin: var(--space-l) 0 0;
    padding-block-start: var(--space-s);
    border-block-start: 1px solid color-mix(in srgb, var(--tinta) 18%, transparent);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  @media (width < 40rem) {
    .emblema {
      width: 4rem;
    }
  }
</style>
