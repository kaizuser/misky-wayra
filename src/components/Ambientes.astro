---
/**
 * Los ambientes: un carrusel de fotos por ambiente de la casa.
 * Editorial: el nombre del ambiente grande en Instrument Serif, a la izquierda; las flechas y
 * el contador a la derecha; debajo, las fotos grandes y rectangulares, que arrancan alineadas
 * con el texto y se van por el borde derecho de la pantalla (se ve que sigue). Se desliza con
 * el dedo, el trackpad o las flechas (scripts/carrusel.ts). Tocar una foto la abre en grande.
 */
import type { ImageMetadata } from 'astro';
import Ampliable from './Ampliable.astro';

interface Foto {
  src: ImageMetadata;
  alt: string;
  encuadre: string;
}

interface Props {
  ambientes: { titulo: string; fotos: Foto[] }[];
}

const { ambientes } = Astro.props;

/** Un ambiente sin fotos muestra esta cantidad de grises */
const PENDIENTES = 6;

---

<div class="ambientes">
  {
    ambientes.map((ambiente, i) => {
      const faltan = ambiente.fotos.length === 0 ? PENDIENTES : 0; // grises solo si todavía no hay fotos
      const total = ambiente.fotos.length + faltan;
      return (
        <section class="ambiente" aria-label={ambiente.titulo} data-carrusel>
          <header class="cabeza" data-revelar>
            <p class="numero">{String(i + 1).padStart(2, '0')}</p>
            <h2>{ambiente.titulo}</h2>
            <div class="controles">
              <p class="contador" aria-live="polite">
                <span data-actual>1</span> / {total}
              </p>
              <button type="button" class="flecha" data-anterior aria-label={`Foto anterior de ${ambiente.titulo}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
              </button>
              <button type="button" class="flecha" data-siguiente aria-label={`Foto siguiente de ${ambiente.titulo}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>
          </header>

          <ul class="pista" data-pista data-galeria data-revelar-juntas tabindex="0" aria-label={`Fotos de ${ambiente.titulo}`}>
            {ambiente.fotos.map((foto, j) => (
              <li class="foto" data-revelar="foto" style={`--encuadre: ${foto.encuadre}; --retraso: ${j < 2 ? j * 0.1 : 0}s`}>
                <Ampliable foto={foto} widths={[500, 800, 1200]} sizes="(min-width: 76rem) 36rem, (min-width: 40rem) calc(50vw - 2.5rem), calc(100vw - 2rem)" />
              </li>
            ))}
            {Array.from({ length: faltan }, () => (
              <li class="foto pendiente" data-revelar="foto">
                <Ampliable widths={[500]} sizes="1px" />
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>

<script>
  import '../scripts/revelar';
  import '../scripts/carrusel';
  import '../scripts/lightbox';
</script>

<style>
  .ambientes {
    --margen: max(var(--gutter), (100vw - var(--axis-width)) / 2); /* margen del contenido */

    display: grid;
    grid-template-columns: minmax(0, 1fr); /* si no, la pista de fotos estira la página de costado */
    gap: var(--space-3xl);
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  /* Simétrico: la cabeza y la pista de fotos ocupan el ancho del contenido, con el mismo
     margen a los dos lados; las fotos se recortan en esos bordes al deslizar */
  .ambiente {
    text-align: start;
  }

  /* ---------- La cabeza: número, nombre, controles ---------- */
  .cabeza {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: var(--space-m);
    margin-inline: var(--margen);
    padding-block-end: var(--space-m);
    border-block-end: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
  }

  .numero {
    margin: 0;
    padding-block-end: 0.5rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--color-primary);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.2rem + 3.6vw, 4.5rem);
    font-weight: 400;
    line-height: 1;
    color: var(--color-text);
  }

  .controles {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding-block-end: 0.35rem;
  }

  .contador {
    margin: 0 var(--space-s) 0 0;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
  }

  .flecha {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-text) 30%, transparent);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition:
      background-color 0.4s ease,
      color 0.4s ease,
      opacity 0.3s;
  }

  .flecha:hover:not(:disabled) {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-color);
  }

  .flecha:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .flecha svg {
    width: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  /* ---------- La pista de fotos ---------- */
  .pista {
    display: flex;
    gap: var(--space-s);
    margin-block: var(--space-l) 0;
    margin-inline: var(--margen);
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  /* Una sola foto: centrada en el carrusel */
  .pista:has(> .foto:only-child) {
    justify-content: center;
  }

  .pista::-webkit-scrollbar {
    display: none;
  }

  .pista:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  /* Dos fotos justas en el ancho del carrusel (una en el celular): el contador es exacto y
     cada deslizada suma una foto */
  .foto {
    flex: none;
    width: calc((100% - var(--space-s)) / 2);
    aspect-ratio: 4 / 5;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
  }


  .foto :global(picture),
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .foto :global(img) {
    object-fit: cover;
    object-position: var(--encuadre, 50% 50%);
    transition: scale 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ampliar:hover :global(img) {
    scale: 1.03;
  }

  .pendiente {
    background: color-mix(in srgb, var(--color-text) 14%, var(--color-bg));
  }

  .pendiente:nth-child(even) {
    background: color-mix(in srgb, var(--color-text) 20%, var(--color-bg));
  }

  @media (width < 40rem) {
    .cabeza {
      grid-template-columns: 1fr auto;
    }

    .numero {
      grid-column: 1 / -1;
      padding: 0;
    }

    /* Una foto por pantalla, y de a una al deslizar (el margen ya es el gutter) */
    .foto {
      width: 100%;
      scroll-snap-stop: always;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pista {
      scroll-behavior: auto;
    }
  }
</style>
