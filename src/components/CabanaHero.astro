---
/**
 * Hero de cada cabaña: la llegada.
 * La foto tiene el mismo view-transition-name que su mitad en el hero de la home,
 * así al navegar la foto se expande y se convierte en este hero.
 *
 * La llegada: la casa ocupa toda la pantalla. La nav flota encima, difuminada (Nav.astro).
 * El texto va abajo, sobre un degradé que solo toca el suelo de la foto: el cielo queda limpio.
 * Abajo, el alero hace de borde hacia la página.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Alero from './Alero.astro';

interface Props {
  nombre: string;
  significado: string;
  frase: string;
  foto: { src: ImageMetadata; alt: string; encuadre: string };
  transicion: string;
}

const { nombre, significado, frase, foto, transicion } = Astro.props;
---

<section class="cabana-hero">
  <figure class="foto" style={`view-transition-name: ${transicion}; --encuadre: ${foto.encuadre}`}>
    <Picture
      src={foto.src}
      alt={foto.alt}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </figure>

  <div class="texto">
    <p class="significado">{significado}</p>
    <h1>{nombre}</h1>
    <p class="frase">{frase}</p>
  </div>

  <div class="borde" aria-hidden="true"><Alero fill="var(--color-bg)" /></div>
</section>

<style>
  .cabana-hero {
    position: relative;
    display: grid;
    align-items: end;
    /* Toda la pantalla; en mobile, menos la barra de abajo (Nav.astro) */
    min-height: max(32rem, 100svh);
    padding: 0;
    overflow: hidden;
  }

  /* ---------- La foto ---------- */
  .foto {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .foto :global(picture),
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .foto :global(img) {
    object-fit: cover;
    object-position: var(--encuadre);
  }

  /* El degradé solo sube desde el suelo: el texto se lee y el cielo queda limpio */
  .foto::after {
    content: '';
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(to bottom, transparent, rgb(43 33 25 / 0.45) 40%, rgb(43 33 25 / 0.78));
    pointer-events: none;
  }

  /* ---------- El texto, abajo y alineado con el resto de la página ---------- */
  .texto {
    position: relative;
    z-index: 1;
    padding-inline: max(var(--gutter), (100% - var(--axis-width)) / 2);
    padding-block-end: calc(var(--alero-alto) + var(--space-xl));
    text-align: start;
    color: var(--color-on-color);
    text-shadow: 0 1px 12px rgb(43 33 25 / 0.35);
  }

  .texto > * + * {
    margin-block-start: var(--space-xs);
  }

  .texto p {
    margin-inline: 0;
  }

  .significado {
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h1 {
    color: inherit;
    font-size: clamp(3rem, 1.6rem + 6vw, 6.5rem);
    line-height: 1;
    text-wrap: balance;
  }

  .frase {
    max-width: 32ch;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  /* ---------- El alero, borde hacia la página ---------- */
  .borde {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    z-index: 1;
    pointer-events: none;
    view-transition-name: borde-abajo; /* queda sobre la foto durante la transición */
  }

  @media (width < 40rem) {
    .cabana-hero {
      min-height: max(28rem, calc(100svh - 6rem));
    }
  }
</style>
