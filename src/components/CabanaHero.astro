---
/**
 * El hero a pantalla completa (cada cabaña y el inicio): la casa ocupa toda la pantalla
 * y la nav (Franja) va justo debajo. `transicion` es su view-transition-name.
 * El texto va abajo, sobre un degradé que solo toca el suelo de la foto: el cielo queda limpio.
 * Al bajar, la foto sube más despacio que la página y se aleja apenas (de 1.06 a 1): como queda
 * recortada en el borde del hero, la sección de abajo parece subir y taparla.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  nombre: string;
  significado: string;
  frase: string;
  /** `vertical`: el mismo encuadre en 9:16, para celulares parados */
  foto: { src: ImageMetadata; alt: string; encuadre: string; vertical?: ImageMetadata };
  transicion: string;
}

const { nombre, significado, frase, foto, transicion } = Astro.props;

// La foto cubre toda la pantalla, así que en una pantalla más angosta que la foto lo que se ve de
// ancho es el alto de la pantalla por la proporción de la foto, no 100vw (con "100vw" el celular
// bajaba una versión de 640 px y la estiraba: se veía borrosa).
// En un celular parado, en vez de bajar la foto horizontal entera para mostrar una franja del
// medio, baja su recorte vertical (9:16): nítido y liviano. Dirección de arte con <picture>.
const proporcion = +(foto.src.width / foto.src.height).toFixed(3);
const PARADO = '(max-aspect-ratio: 3/4)';

const srcset = async (src: ImageMetadata, anchos: number[], format: 'avif' | 'webp') =>
  (
    await Promise.all(
      anchos
        .filter((a) => a <= src.width)
        // AVIF en calidad 42: a pantalla completa no se distingue de la 50 y pesa ~35% menos
        .map((width) => getImage({ src, width, format, ...(format === 'avif' && { quality: 42 }) })),
    )
  )
    .map((img) => `${img.src} ${img.attributes.width}w`)
    .join(', ');

const ANCHOS = [640, 1024, 1280, 1600, 1920];
const ANCHOS_VERTICAL = [480, 720, 960, 1200];
const fuentes = [
  ...(foto.vertical
    ? (['avif', 'webp'] as const).map(async (format) => ({
        media: PARADO,
        type: `image/${format}`,
        srcset: await srcset(foto.vertical!, ANCHOS_VERTICAL, format),
        // en un celular más angosto que 9:16 se ve el alto por 0.5625
        sizes: '(max-aspect-ratio: 9/16) 57vh, 100vw',
      }))
    : []),
  ...(['avif', 'webp'] as const).map(async (format) => ({
    media: undefined,
    type: `image/${format}`,
    srcset: await srcset(foto.src, ANCHOS, format),
    sizes: `(max-aspect-ratio: ${proporcion}) ${Math.round(proporcion * 100)}vh, 100vw`,
  })),
];
const sources = await Promise.all(fuentes);
const respaldo = await getImage({ src: foto.src, width: 1280, format: 'jpg' });
---

<section class="cabana-hero">
  <figure class="foto" style={`view-transition-name: ${transicion}; --encuadre: ${foto.encuadre}`}>
    <picture>
      {sources.map((s) => <source media={s.media} type={s.type} srcset={s.srcset} sizes={s.sizes} />)}
      <img
        src={respaldo.src}
        width={respaldo.attributes.width}
        height={respaldo.attributes.height}
        alt={foto.alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </figure>

  <div class="texto">
    <p class="significado">{significado}</p>
    <h1>{nombre}</h1>
    <p class="frase">{frase}</p>
  </div>

</section>

<style>
  .cabana-hero {
    position: relative;
    display: grid;
    align-items: end;
    /* Toda la pantalla */
    min-height: max(32rem, 100svh);
    padding: 0;
    overflow: hidden;
  }

  /* ---------- La foto ---------- */
  .foto {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .foto :global(picture),
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .foto :global(img) {
    object-fit: cover;
    object-position: var(--encuadre);
  }

  /* Parado, la foto ya es el recorte vertical centrado en lo importante */
  @media (max-aspect-ratio: 3/4) {
    .foto :global(img) {
      object-position: 50% 50%;
    }
  }

  /* El degradé solo sube desde el suelo: el texto se lee y el cielo queda limpio */
  .foto::after {
    content: '';
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(to bottom, transparent, rgb(43 33 25 / 0.45) 40%, rgb(43 33 25 / 0.78));
    pointer-events: none;
  }

  /* ---------- El texto, abajo y alineado con el resto de la página ---------- */
  .texto {
    position: relative;
    z-index: 1;
    padding-inline: max(var(--gutter), (100% - var(--axis-width)) / 2);
    padding-block-end: var(--space-2xl);
    text-align: start;
    color: var(--color-on-color);
    text-shadow: 0 1px 12px rgb(43 33 25 / 0.35);
  }

  .texto > * + * {
    margin-block-start: var(--space-xs);
  }

  .texto p {
    margin-inline: 0;
  }

  .significado {
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h1 {
    color: inherit;
    font-size: clamp(3rem, 1.6rem + 6vw, 6.5rem);
    line-height: 1;
    text-wrap: balance;
  }

  .frase {
    max-width: 32ch;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  /* ---------- Al bajar: la foto sube más lento y se aleja apenas ----------
     Atado al scroll de la página, del principio hasta que el hero salió de la pantalla.
     Solo transform: lo resuelve la placa de video, sin trabajo extra. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .foto :global(picture) {
        animation: alejarse linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 100svh;
        transform-origin: 50% 50%;
      }

      @keyframes alejarse {
        from { transform: translateY(0) scale(1.06); }
        to { transform: translateY(33%) scale(1); }
      }

      /* El texto se va desvaneciendo mientras sube, antes de llegar a la nav flotante */
      .texto {
        animation: desvanecerse linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 45svh;
      }

      @keyframes desvanecerse {
        to { opacity: 0; }
      }
    }
  }

</style>
